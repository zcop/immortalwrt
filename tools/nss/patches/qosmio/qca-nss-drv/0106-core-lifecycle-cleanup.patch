+static void nss_common_cleanup(void)
+{
+	if (!nss_ready) {
+		return;
+	}
+	nss_ready = false;
+
+	nss_info("Exit NSS driver");
+
+	/*
+	 * Stop panic callbacks before the core mappings are torn down.
