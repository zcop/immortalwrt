 void nss_coredump_notify_register(void)
 {
-	atomic_notifier_chain_register(&panic_notifier_list, &nss_panic_nb);
+	if (atomic_notifier_chain_register(&panic_notifier_list, &nss_panic_nb) == 0) {
+		nss_panic_registered = true;
+	}
+}
+
+/*
+ * nss_coredump_notify_unregister()
+ *	Remove the coredump notifier from the panic chain.
+ */
+void nss_coredump_notify_unregister(void)
+{
+	WRITE_ONCE(coredump_stopping, true);
+
+	if (coredump_workqueue) {
+		cancel_delayed_work_sync(&coredump_queuewait);
+	}
+
+	if (!nss_panic_registered) {
+		return;
+	}
+
+	atomic_notifier_chain_unregister(&panic_notifier_list, &nss_panic_nb);
+	nss_panic_registered = false;
+}
+
+/*
+ * nss_coredump_destroy_delay_work()
+ *	Cancel the pending coredump timeout and free its workqueue.
+ */
+void nss_coredump_destroy_delay_work(void)
+{
+	if (!coredump_workqueue) {
+		return;
+	}
+
+	cancel_delayed_work_sync(&coredump_queuewait);
+	destroy_workqueue(coredump_workqueue);
+	coredump_workqueue = NULL;
 }
 
