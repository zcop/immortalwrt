+		nss_dev_header = NULL;
+	}
+#else
+	if (nss_clk_hdr) {
+		unregister_sysctl_table(nss_clk_hdr);
+		nss_clk_hdr = NULL;
+	}
+
+	if (nss_gen_hdr) {
+		unregister_sysctl_table(nss_gen_hdr);
+		nss_gen_hdr = NULL;
+	}
+
+	if (nss_skb_hdr) {
+		unregister_sysctl_table(nss_skb_hdr);
+		nss_skb_hdr = NULL;
+	}
+#endif
+	/*
+	 * Unregister n2h specific sysctl
+	 */
+	nss_n2h_unregister_sysctl();
+
+	/*
+	 * Unregister rps specific sysctl
+	 */
+	nss_rps_unregister_sysctl();
+
+#ifdef NSS_DRV_C2C_ENABLE
+	/*
+	 * Unregister c2c_tx specific sysctl
+	 */
+	nss_c2c_tx_unregister_sysctl();
+#endif
+
+	/*
+	 * Unregister pppoe specific sysctl
+	 */
+#ifdef NSS_DRV_PPPOE_ENABLE
+	nss_pppoe_unregister_sysctl();
+#endif
+
+	/*
+	 * Unregister ipv4/6 specific sysctl. Connection tables are freed after
+	 * the hardware and IRQ producers have been stopped.
+	 */
+#ifdef NSS_DRV_IPV4_ENABLE
+	nss_ipv4_unregister_sysctl();
+#endif
+
+#ifdef NSS_DRV_IPV6_ENABLE
+	nss_ipv6_unregister_sysctl();
+#endif
+
+	nss_project_unregister_sysctl();
+	nss_stats_unregister_sysctl();
+
+#ifdef NSS_DATA_PLANE_GENERIC_SUPPORT
+	nss_data_plane_destroy_delay_work();
+#endif
+
+#ifdef NSS_DATA_PLANE_LITE_SUPPORT
+	nss_data_plane_lite_destroy_delay_work();
+#endif
+
+	/*
+	 * cleanup ppe on supported platform
+	 */
+#ifdef NSS_DRV_PPE_ENABLE
+	nss_ppe_free();
+#endif
+
+	/*
+	 * Unregistering the platform driver drains the remove callbacks, which
+	 * stop IRQ/NAPI producers. Only then is it safe to destroy the queues.
+	 */
+	if (nss_platform_registered) {
+		platform_driver_unregister(&nss_driver);
+		nss_platform_registered = false;
+	}
+
+	/*
+	 * The hardware and its IRQ/NAPI producers are gone; only now release
+	 * the DMA-visible connection pages and their ownership tracking.
+	 */
+#ifdef NSS_DRV_IPV4_ENABLE
+	nss_ipv4_free_conn_tables();
+#endif
+
+#ifdef NSS_DRV_IPV6_ENABLE
+	nss_ipv6_free_conn_tables();
+#endif
+
+	/*
+	 * Final cancel covers a producer that passed the stopping check just
+	 * before shutdown and queued work after the early cancel.
+	 */
+	nss_coredump_destroy_delay_work();
+
+	if (nss_wq) {
+		destroy_workqueue(nss_wq);
+		nss_wq = NULL;
+	}
+
+	nss_stats_clean();
+}
