Admit a live standalone QCA8337 customer VLAN underlay.

Keep VLAN-aware/unaware bridge customer uppers, VLAN+PPPoE, nested VLANs
and stale/unpublished uppers excluded for QCA. Preserve all YT921x paths.

--- a/frontends/nss/ecm_nss_common.c
+++ b/frontends/nss/ecm_nss_common.c
@@ -27,6 +27,7 @@
 #if IS_ENABLED(CONFIG_NET_DSA)
 #include <linux/dsa/8021q.h>
 #include <linux/dsa/yt921x_qinq.h>
+#include <linux/dsa/qca_qinq.h>
 #include <net/dsa.h>
 #endif
 
@@ -115,7 +116,7 @@
 	}
 
 	/* QCA8337 admits native Ethernet/bridge traffic and one standalone
-	 * PPPoE session. Customer VLANs and bridged PPP underlays stay excluded.
+	 * PPPoE session. A live standalone customer VLAN is also admitted; bridged PPP stays excluded.
 	 */
 	if (dsa_port_from_netdev(port)->ds->dst->tag_ops->proto == DSA_TAG_PROTO_QCA_QINQ) {
 		struct dsa_port *qdp = dsa_port_from_netdev(port);
@@ -126,7 +127,7 @@
 
 		rcu_read_lock();
 		br = dsa_port_bridge_dev_get(qdp);
-		ret = (br && br_vlan_enabled(br)) ||
+		ret = (br && br_vlan_enabled(br)) || (direct && br) ||
 		      netdev_master_upper_dev_get_rcu(port) != br ? -EOPNOTSUPP : 0;
 		rcu_read_unlock();
 		if (ret)
@@ -152,7 +153,7 @@
 			}
 #endif
 			if (type != ECM_DB_IFACE_TYPE_ETHERNET &&
-			    type != ECM_DB_IFACE_TYPE_BRIDGE) {
+			    type != (direct ? ECM_DB_IFACE_TYPE_VLAN : ECM_DB_IFACE_TYPE_BRIDGE)) {
 				ret = -EOPNOTSUPP;
 				goto out;
 			}
@@ -219,7 +220,9 @@
 		cvid = vlan_dev_vlan_id(direct);
 		if (vlan_dev_real_dev(direct) != port ||
 		    netdev_master_upper_dev_get_rcu(direct) ||
-		    !dsa_yt921x_qinq_direct_vid_valid(dp, cvid)) {
+		    !(dp->ds->dst->tag_ops->proto == DSA_TAG_PROTO_QCA_QINQ ?
+		      dsa_qca_qinq_direct_vid_valid(dp, cvid) :
+		      dsa_yt921x_qinq_direct_vid_valid(dp, cvid))) {
 			ret = -EOPNOTSUPP;
 			goto unlock;
 		}
