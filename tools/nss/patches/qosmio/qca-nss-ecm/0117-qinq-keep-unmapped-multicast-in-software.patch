+#ifdef ECM_MULTICAST_ENABLE
+/* No per-replica QinQ encoder exists yet. Never substitute a conduit for a
+ * user port: a shared conduit could deliver the group to the wrong ports.
+ */
+static int ecm_nss_qinq_multicast_lower(struct net_device *dev,
+                                      struct netdev_nested_priv *priv)
+{
+	if (ecm_nss_qinq_is_port(dev) || ecm_nss_qinq_is_upper(dev))
+		return -EOPNOTSUPP;
+	return 0;
+}
+
+static bool ecm_nss_qinq_multicast_hierarchy(
+		struct ecm_db_iface_instance *ifaces[], int first)
+{
+	int i;
+
+	if (first < 0 || first >= ECM_DB_IFACE_HEIRARCHY_MAX)
+		return false;
+	for (i = first; i < ECM_DB_IFACE_HEIRARCHY_MAX; i++) {
+		struct netdev_nested_priv priv = {};
+		struct net_device *dev;
+		bool supported;
+
+		dev = dev_get_by_index(&init_net,
+				ecm_db_iface_interface_identifier_get(ifaces[i]));
+		if (!dev)
+			return false;
+		rcu_read_lock();
+		supported = !ecm_nss_qinq_multicast_lower(dev, &priv) &&
+			!netdev_walk_all_lower_dev_rcu(dev,
+					ecm_nss_qinq_multicast_lower, &priv);
+		rcu_read_unlock();
+		dev_put(dev);
+		if (!supported)
+			return false;
+	}
+	return true;
+}
+
+/* Check the complete replication set, including bridge/VLAN lower devices.
+ * A membership update must fall back as a whole, never retain a partial NSS
+ * replica set. Call before accel_pending_set and before modifying an update's
+ * acceleration state so the existing caller can destroy a live firmware rule.
+ */
+bool ecm_nss_qinq_multicast_admit(struct ecm_db_connection_instance *ci)
+{
+	struct ecm_db_iface_instance *from[ECM_DB_IFACE_HEIRARCHY_MAX];
+	struct ecm_db_iface_instance *to[ECM_DB_IFACE_HEIRARCHY_MAX];
+	struct ecm_db_iface_instance *to_all, *hierarchy;
+	int32_t *to_first;
+	int first, vif;
+	bool supported, have_destination = false;
+
+	first = ecm_db_connection_interfaces_get_and_ref(ci, from,
+						ECM_DB_OBJ_DIR_FROM);
+	if (first == ECM_DB_IFACE_HEIRARCHY_MAX)
+		return false;
+	supported = ecm_nss_qinq_multicast_hierarchy(from, first);
+	ecm_db_connection_interfaces_deref(from, first);
+	if (!supported)
+		return false;
+	if (!ecm_db_multicast_connection_to_interfaces_get_and_ref_all(ci,
+						&to_all, &to_first))
+		return false;
+	for (vif = 0; vif < ECM_DB_MULTICAST_IF_MAX; vif++) {
+		if (to_first[vif] == ECM_DB_IFACE_HEIRARCHY_MAX)
+			continue;
+		have_destination = true;
+		hierarchy = ecm_db_multicast_if_heirarchy_get(to_all, vif);
+		ecm_db_multicast_copy_if_heirarchy(to, hierarchy);
+		if (!ecm_nss_qinq_multicast_hierarchy(to, to_first[vif])) {
+			supported = false;
+			break;
+		}
+	}
+	ecm_db_multicast_connection_to_interfaces_deref_all(to_all, to_first);
+	return supported && have_destination;
+}
+#endif
