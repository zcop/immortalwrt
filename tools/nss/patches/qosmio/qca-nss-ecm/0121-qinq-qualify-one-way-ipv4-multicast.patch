+static inline int ecm_classifier_packet_accel_delay(bool one_way_multicast)
+{
+	int delay = READ_ONCE(ecm_classifier_accel_delay_pkts);
+
+	/* A verified multicast route has no return stream. Inspect two slow
+	 * path packets in the default reply-wait mode.
+	 */
+	if (delay == 1 && one_way_multicast)
+		return 2;
+	return delay;
+}
 
