+static bool ecm_nss_mc_mfc_registered;
+static bool ecm_nss_qinq_mc_registered;
+
+/* The IPv4 route passed ECM's normal classifiers. Bridge filters are a
+ * separate stage and cannot be reproduced by the QCA destination override.
+ */
+static bool ecm_nss_qinq_mc_bridge_policy_supported(void)
+{
+#ifdef CONFIG_NETFILTER_FAMILY_BRIDGE
+	struct module *owner = THIS_MODULE;
+	const struct nf_hook_entries *entries;
+	unsigned int i;
+
+	if (rcu_access_pointer(init_net.nf.hooks_bridge[NF_BR_LOCAL_OUT]))
+		return false;
+	entries = rcu_dereference(init_net.nf.hooks_bridge[NF_BR_POST_ROUTING]);
+	if (entries)
+		for (i = 0; i < entries->num_hook_entries; i++)
+			if (!owner ||
+			    !within_module((unsigned long)entries->hooks[i].hook, owner))
+				return false;
+#endif
+	return !rcu_access_pointer(br_multicast_handle_hook);
+}
