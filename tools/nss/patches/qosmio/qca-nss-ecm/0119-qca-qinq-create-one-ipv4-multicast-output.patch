+/* The whole Linux multicast route must terminate at one native wired bridge.
+ * The bridge MDB supplies the complete receiver set. The driver publishes this
+ * exact bitmap only after the QCA8337 ACL has been read back successfully.
+ */
+static bool ecm_nss_qinq_ipv4_mc_rule(struct ecm_front_end_connection_instance *feci,
+				     struct sk_buff *skb, struct nf_conn *ct,
+				     struct nss_ipv4_mc_rule_create_msg *rule)
+{
+	struct ecm_db_connection_instance *ci = feci->ci;
+	struct dsa_switch *ds = NULL;
+	struct dsa_port *src_dp, *dp;
+	struct nss_ipv4_mc_if_rule *out = &rule->if_rule[0];
+	struct net_device *src, *br, *lower, *conduit = NULL;
+	struct list_head *iter;
+	u32 dst[4], br_index;
+	u8 ports = 0;
+	__be32 origin, group;
+	ip_addr_t ip;
+	u16 svid, cvid = 0;
+	int count, i, src_if, dst_if, cpu = -1;
+	bool ok = false;
+
+	if (!ecm_nss_mc_mfc_registered || !ecm_nss_qinq_mc_registered ||
+	    !ecm_db_connection_is_routed_get(ci) || !skb || !skb->skb_iif ||
+	    skb_vlan_tag_present(skb) || (ct && (READ_ONCE(ct->status) & IPS_NAT_MASK)))
+		return false;
+
+	ecm_db_connection_address_get(ci, ECM_DB_OBJ_DIR_FROM, ip);
+	origin = htonl(ip[0]);
+	ecm_db_connection_address_get(ci, ECM_DB_OBJ_DIR_TO, ip);
+	group = htonl(ip[0]);
+	if (ipmr_qinq_ipv4_mc_route(&init_net, origin, group, skb->skb_iif, &br_index))
+		return false;
+
+	rcu_read_lock();
+	if (!ecm_nss_qinq_mc_bridge_policy_supported())
+		goto out_unlock;
+	src = dev_get_by_index_rcu(&init_net, skb->skb_iif);
+	br = dev_get_by_index_rcu(&init_net, br_index);
+	if (!src || !br || netdev_master_upper_dev_get_rcu(src) ||
+	    !dsa_user_dev_check(src) || !netif_carrier_ok(src) || !netif_running(src))
+		goto out_unlock;
+	src_dp = dsa_port_from_netdev(src);
+	if (IS_ERR_OR_NULL(src_dp) || !src_dp->cpu_dp || !src_dp->ds->dst->tag_ops ||
+	    src_dp->ds->dst->tag_ops->proto != DSA_TAG_PROTO_QCA_QINQ)
+		goto out_unlock;
+
+	count = br_qinq_ipv4_mc_members(br, group, dst, ARRAY_SIZE(dst));
+	if (count <= 0)
+		goto out_unlock;
+
+	iter = &br->adj_list.lower;
+	while ((lower = netdev_next_lower_dev_rcu(br, &iter))) {
+		int bridge_num;
+
+		if (!dsa_user_dev_check(lower))
+			goto out_unlock;
+		dp = dsa_port_from_netdev(lower);
+		if (IS_ERR_OR_NULL(dp) || dp->ds != src_dp->ds || !dp->cpu_dp ||
+		    dsa_port_bridge_dev_get(dp) != br)
+			goto out_unlock;
+		bridge_num = dsa_port_bridge_num_get(dp);
+		if (bridge_num <= 0 || bridge_num > DSA_TAG_8021Q_MAX_NUM_BRIDGES)
+			goto out_unlock;
+		if (ds && (dp->cpu_dp->index != cpu ||
+		           dsa_tag_8021q_bridge_vid(bridge_num) != cvid))
+			goto out_unlock;
+		ds = dp->ds;
+		cpu = dp->cpu_dp->index;
+		conduit = dp->cpu_dp->conduit;
+		cvid = dsa_tag_8021q_bridge_vid(bridge_num);
+		for (i = 0; i < count; i++)
+			if (dst[i] == lower->ifindex)
+				ports |= BIT(dp->index);
+	}
+
+	if (!ds || hweight8(ports) != count || !conduit || !netif_carrier_ok(conduit) ||
+	    !ds->ops->qinq_ipv4_mc_ready ||
+	    !ds->ops->qinq_ipv4_mc_ready(ds, cpu, cvid, group, ports))
+		goto out_unlock;
+
+	src_if = nss_cmn_get_interface_number_by_dev(src_dp->cpu_dp->conduit);
+	dst_if = nss_cmn_get_interface_number_by_dev(conduit);
+	if (src_if < 0 || dst_if < 0 || src_if == dst_if)
+		goto out_unlock;
+
+	svid = dsa_tag_8021q_standalone_vid(src_dp);
+	rule->src_interface_num = src_if;
+	rule->ingress_vlan_tag[0] = (ETH_P_8021AD << 16) | svid;
+	rule->ingress_vlan_tag[1] = (ETH_P_8021Q << 16) | svid;
+	rule->valid_flags |= NSS_IPV4_MC_RULE_CREATE_FLAG_INGRESS_VLAN_VALID;
+	rule->if_count = 1;
+	out->if_num = dst_if;
+	out->if_mtu = READ_ONCE(br->mtu);
+	out->xlate_src_ip = ntohl(origin);
+	out->xlate_src_ident = ecm_db_connection_port_get(ci, ECM_DB_OBJ_DIR_FROM);
+	out->rule_flags = NSS_IPV4_MC_RULE_CREATE_IF_FLAG_ROUTED_FLOW |
+			  NSS_IPV4_MC_RULE_CREATE_IF_FLAG_JOIN;
+	out->valid_flags = NSS_IPV4_MC_RULE_CREATE_IF_FLAG_VLAN_VALID;
+	out->egress_vlan_tag[0] = (ETH_P_8021AD << 16) | dsa_qca_qinq_ipv4_mc_svid(group);
+	out->egress_vlan_tag[1] = (ETH_P_8021Q << 16) | cvid;
+	ether_addr_copy((u8 *)out->if_mac, br->dev_addr);
+	ok = true;
+out_unlock:
+	rcu_read_unlock();
+	return ok;
 }
 
