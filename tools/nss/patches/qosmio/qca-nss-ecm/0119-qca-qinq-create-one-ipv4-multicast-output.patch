+/* Invalidate the whole firmware rule after the switch withdraws admission.
+ * Ordinary listener changes within a still eligible bridge update only ACLs.
+ */
+static int ecm_nss_qinq_mc_withdrawn(struct notifier_block *nb,
+				     unsigned long event, void *data)
+{
+	struct ecm_db_multicast_tuple_instance *ti, *next;
+	ip_addr_t group, entry_group;
+
+	if (event != BR_QINQ_MC_WITHDRAWN)
+		return NOTIFY_DONE;
+	ECM_HIN4_ADDR_TO_IP_ADDR(group, ntohl(*(__be32 *)data));
+	for (ti = ecm_db_multicast_connection_get_and_ref_first(group); ti; ti = next) {
+		struct ecm_front_end_connection_instance *feci;
+		struct ecm_db_connection_instance *ci;
+
+		next = ecm_db_multicast_connection_get_and_ref_next(ti);
+		ecm_db_multicast_tuple_instance_group_ip_get(ti, entry_group);
+		if (ECM_IP_ADDR_MATCH(group, entry_group)) {
+			ci = ecm_db_multicast_connection_get_from_tuple(ti);
+			feci = ecm_db_connection_front_end_get_and_ref(ci);
+			if (READ_ONCE(feci->qinq_ipv4_mc))
+				ecm_db_connection_make_defunct(ci);
+			ecm_front_end_connection_deref(feci);
+		}
+		ecm_db_multicast_connection_deref(ti);
+	}
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block ecm_nss_qinq_mc_nb = {
+	.notifier_call = ecm_nss_qinq_mc_withdrawn,
+};
