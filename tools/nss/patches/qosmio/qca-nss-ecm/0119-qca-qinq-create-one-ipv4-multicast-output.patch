+static bool ecm_interface_qca_qinq_bridge(struct net_device *bridge)
+{
+	struct net_device *lower;
+	struct list_head *iter;
+	bool qca = false;
+
+	if (!netif_is_bridge_master(bridge))
+		return false;
+	rcu_read_lock();
+	iter = &bridge->adj_list.lower;
+	while ((lower = netdev_next_lower_dev_rcu(bridge, &iter))) {
+		struct dsa_port *dp;
+
+		if (!dsa_user_dev_check(lower)) {
+			qca = false;
+			break;
+		}
+		dp = dsa_port_from_netdev(lower);
+		if (IS_ERR_OR_NULL(dp) || !dp->ds->dst->tag_ops ||
+		    dp->ds->dst->tag_ops->proto != DSA_TAG_PROTO_QCA_QINQ) {
+			qca = false;
+			break;
+		}
+		qca = true;
+	}
+	rcu_read_unlock();
+	return qca;
+}
