+/*
+ * First L2 slice: one Wi-Fi port and one QinQ port in the same unaware
+ * bridge. Keep customer VLANs, hairpin and same-switch forwarding on their
+ * existing paths. FDB misses/changes are retryable, never a guessed port.
+ */
+int ecm_nss_qinq_bridge_validate(struct ecm_db_connection_instance *ci,
+	struct ecm_db_iface_instance *from_ifaces[], int from_first,
+	struct ecm_db_iface_instance *to_ifaces[], int to_first, bool tagged)
+{
+	struct net_device *from, *to, *br, *found;
+	unsigned char mac[ETH_ALEN];
+	unsigned long restricted = BR_ISOLATED | BR_PORT_LOCKED | BR_PORT_MAB |
+		BR_PROXYARP | BR_PROXYARP_WIFI | BR_NEIGH_SUPPRESS |
+		BR_NEIGH_VLAN_SUPPRESS | BR_VLAN_TUNNEL;
+	bool from_qinq, to_qinq;
+	int ret = -EOPNOTSUPP;
+
+	if (ecm_db_connection_is_routed_get(ci))
+		return 0;
+	if (tagged)
+		return -EOPNOTSUPP;
+#if !defined(ECM_DB_XREF_ENABLE) || !defined(ECM_BAND_STEERING_ENABLE)
+	/* Existing ECM FDB move/delete invalidation is mandatory for L2. */
+	return -EOPNOTSUPP;
+#endif
+	rcu_read_lock();
+	from = ecm_nss_qinq_bridge_port_get(from_ifaces, from_first);
+	to = ecm_nss_qinq_bridge_port_get(to_ifaces, to_first);
+	if (!from || !to || from == to)
+		goto out;
+	br = netdev_master_upper_dev_get_rcu(from);
+	if (!br || !netif_is_bridge_master(br) ||
+	    br != netdev_master_upper_dev_get_rcu(to) || br_vlan_enabled(br))
+		goto out;
+	from_qinq = ecm_nss_qinq_is_port(from);
+	to_qinq = ecm_nss_qinq_is_port(to);
+	if (from_qinq == to_qinq ||
+	    !(from_qinq ? to : from)->ieee80211_ptr)
+		goto out;
+	if (br_port_flag_is_set(from, restricted) ||
+	    br_port_flag_is_set(to, restricted))
+		goto out;
+	ret = -EAGAIN;
+	if (!netif_running(from) || !netif_running(to) ||
+	    !netif_carrier_ok(from) || !netif_carrier_ok(to) ||
+	    br_port_get_stp_state_rcu(from) != BR_STATE_FORWARDING ||
+	    br_port_get_stp_state_rcu(to) != BR_STATE_FORWARDING)
+		goto out;
+	ecm_db_connection_node_address_get(ci, ECM_DB_OBJ_DIR_FROM, mac);
+	if (!is_valid_ether_addr(mac))
+		goto out;
+	found = br_port_dev_get(br, mac, NULL, 0);
+	if (found) {
+		bool matches = found == from;
+
+		dev_put(found);
+		if (!matches)
+			goto out;
+	} else {
+		goto out;
+	}
+	ecm_db_connection_node_address_get(ci, ECM_DB_OBJ_DIR_TO_NAT, mac);
+	if (!is_valid_ether_addr(mac))
+		goto out;
+	found = br_port_dev_get(br, mac, NULL, 0);
+	if (found) {
+		ret = found == to ? 0 : -EAGAIN;
+		dev_put(found);
+	}
+out:
+	if (from)
+		dev_put(from);
+	if (to)
+		dev_put(to);
+	rcu_read_unlock();
+	return ret;
+}
