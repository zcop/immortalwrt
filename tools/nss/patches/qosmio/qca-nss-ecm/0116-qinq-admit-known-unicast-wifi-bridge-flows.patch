+/* Caller holds RCU. Return a referenced, current bridge port, never an upper. */
+static struct net_device *ecm_nss_qinq_bridge_port_get(
+	struct ecm_db_iface_instance *ifaces[], int first)
+{
+	struct net_device *port = NULL, *bridge = NULL, *dev, *master;
+	int i;
+
+	for (i = first; i < ECM_DB_IFACE_HEIRARCHY_MAX; i++) {
+		ecm_db_iface_type_t type = ecm_db_iface_type_get(ifaces[i]);
+
+		if (type != ECM_DB_IFACE_TYPE_ETHERNET &&
+		    type != ECM_DB_IFACE_TYPE_BRIDGE)
+			goto fail;
+		dev = dev_get_by_index(&init_net,
+			ecm_db_iface_interface_identifier_get(ifaces[i]));
+		if (!dev)
+			goto fail;
+		if (type == ECM_DB_IFACE_TYPE_BRIDGE) {
+			if (bridge || !netif_is_bridge_master(dev)) {
+				dev_put(dev);
+				goto fail;
+			}
+			bridge = dev;
+		} else {
+			if (port || !netif_is_bridge_port(dev)) {
+				dev_put(dev);
+				goto fail;
+			}
+			port = dev;
+		}
+	}
+	if (!port)
+		goto fail;
+	master = netdev_master_upper_dev_get_rcu(port);
+	if (!master || !netif_is_bridge_master(master) ||
+	    (bridge && bridge != master))
+		goto fail;
+	if (bridge)
+		dev_put(bridge);
+	return port;
+fail:
+	if (bridge)
+		dev_put(bridge);
+	if (port)
+		dev_put(port);
+	return NULL;
+}
