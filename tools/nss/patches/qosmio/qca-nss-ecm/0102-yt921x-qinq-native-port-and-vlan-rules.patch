 #define DEBUG_LEVEL ECM_NSS_COMMON_DEBUG_LEVEL
 
@@ -42,6 +48,160 @@
 #include "ecm_nss_ipv6.h"
 #include "ecm_nss_ipv4.h"
 
+#if IS_ENABLED(CONFIG_NET_DSA)
+/* Owned by the optional qca-nss-qinq module, pinned only during lookup. */
+int qca_nss_qinq_resolve(struct net_device *conduit, u16 svid, u16 *vid);
+
+bool ecm_nss_qinq_is_port(struct net_device *dev)
+{
+	struct dsa_port *dp;
+
+	if (!dsa_user_dev_check(dev))
+		return false;
+	dp = dsa_port_from_netdev(dev);
+	return !IS_ERR_OR_NULL(dp) && dp->ds && dp->ds->dst && dp->ds->dst->tag_ops &&
+	       dp->ds->dst->tag_ops->proto == DSA_TAG_PROTO_YT921X_QINQ;
+}
+
+bool ecm_nss_qinq_is_upper(struct net_device *dev)
+{
+	return is_vlan_dev(dev) && ecm_nss_qinq_is_port(vlan_dev_real_dev(dev));
+}
+
+int ecm_nss_qinq_side_get(struct ecm_db_connection_instance *ci,
+	struct ecm_db_iface_instance *ifaces[], int first,
+	struct ecm_nss_qinq_side *side)
+{
+	struct net_device *port = NULL, *dev, *br, *conduit;
+	struct bridge_vlan_info vinfo;
+	struct dsa_port *dp;
+	int (*resolve)(struct net_device *, u16, u16 *);
+	int i, ret = 0;
+	u16 svid, cvid = 0;
+
+	memset(side, 0, sizeof(*side));
+	for (i = first; i < ECM_DB_IFACE_HEIRARCHY_MAX; i++) {
+		dev = dev_get_by_index(&init_net, ecm_db_iface_interface_identifier_get(ifaces[i]));
+		if (!dev) {
+			ret = -ENODEV;
+			goto out;
+		}
+		if (ecm_nss_qinq_is_upper(dev)) {
+			dev_put(dev);
+			ret = -EOPNOTSUPP;
+			goto out;
+		}
+		if (!ecm_nss_qinq_is_port(dev)) {
+			dev_put(dev);
+			continue;
+		}
+		if (port) {
+			dev_put(dev);
+			ret = -EOPNOTSUPP;
+			goto out;
+		}
+		port = dev;
+	}
+	if (!port)
+		return 0;
+
+	/* This first native mapping supports plain routed Ethernet/bridge/VLAN
+	 * hierarchies. Do not mistake a PPP/tunnel next hop for the QinQ leaf.
+	 */
+	for (i = first; i < ECM_DB_IFACE_HEIRARCHY_MAX; i++) {
+		ecm_db_iface_type_t type = ecm_db_iface_type_get(ifaces[i]);
+
+		if (type != ECM_DB_IFACE_TYPE_ETHERNET &&
+		    type != ECM_DB_IFACE_TYPE_BRIDGE && type != ECM_DB_IFACE_TYPE_VLAN) {
+			ret = -EOPNOTSUPP;
+			goto out;
+		}
+	}
+	if (!ecm_db_connection_is_routed_get(ci)) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+
+	rcu_read_lock();
+	dp = dsa_port_from_netdev(port);
+	if (IS_ERR_OR_NULL(dp) || !dp->cpu_dp || !dp->ds->tag_8021q_ctx) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	conduit = dp->cpu_dp->conduit;
+	svid = dsa_tag_8021q_standalone_vid(dp);
+	br = dsa_port_bridge_dev_get(dp);
+	if (!br) {
+		cvid = svid;
+	} else if (!br_vlan_enabled(br)) {
+		int bridge_num = dsa_port_bridge_num_get(dp);
+
+		if (bridge_num <= 0 || bridge_num > DSA_TAG_8021Q_MAX_NUM_BRIDGES) {
+			ret = -EINVAL;
+			goto unlock;
+		}
+		cvid = dsa_tag_8021q_bridge_vid(bridge_num);
+	} else {
+		/* A VLAN upper of this bridge gives the exact side-specific VID.
+		 * Otherwise resolve() accepts only a single ready port leaf.
+		 */
+		for (i = first; i < ECM_DB_IFACE_HEIRARCHY_MAX; i++) {
+			dev = dev_get_by_index(&init_net, ecm_db_iface_interface_identifier_get(ifaces[i]));
+			if (!dev) {
+				ret = -ENODEV;
+				goto unlock;
+			}
+			if (is_vlan_dev(dev)) {
+				u16 vid = vlan_dev_vlan_id(dev);
+
+				if (vlan_dev_real_dev(dev) != br || (cvid && cvid != vid)) {
+					dev_put(dev);
+					ret = -EOPNOTSUPP;
+					goto unlock;
+				}
+				cvid = vid;
+			}
+			dev_put(dev);
+		}
+	}
+	side->physical = nss_cmn_get_interface_number_by_dev(conduit);
+	if (side->physical < 0 || side->physical >= NSS_MAX_PHYSICAL_INTERFACES) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	resolve = symbol_get(qca_nss_qinq_resolve);
+	if (!resolve) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	side->leaf = resolve(conduit, svid, &cvid);
+	symbol_put(qca_nss_qinq_resolve);
+	if (side->leaf < 0 || !cvid || cvid == VLAN_VID_MASK) {
+		ret = -ENOENT;
+		goto unlock;
+	}
+	if (br && br_vlan_enabled(br) && br_vlan_get_info_rcu(port, cvid, &vinfo)) {
+		ret = -ENOENT;
+		goto unlock;
+	}
+	side->outer = (ETH_P_8021AD << 16) | svid;
+	side->inner = (ETH_P_8021Q << 16) | cvid;
+	ret = 1;
+unlock:
+	rcu_read_unlock();
+out:
+	if (port)
+		dev_put(port);
+	return ret;
+}
+#else
+bool ecm_nss_qinq_is_port(struct net_device *dev) { return false; }
+bool ecm_nss_qinq_is_upper(struct net_device *dev) { return false; }
+int ecm_nss_qinq_side_get(struct ecm_db_connection_instance *ci,
+	struct ecm_db_iface_instance *ifaces[], int first,
+	struct ecm_nss_qinq_side *side) { return 0; }
+#endif
