+			if (ok && dp->ds->dst->tag_ops->proto == DSA_TAG_PROTO_QCA_QINQ)
+				ok = !netdev_master_upper_dev_get_rcu(dev) &&
+				     __vlan_find_dev_deep_rcu(br, htons(ETH_P_8021Q),
