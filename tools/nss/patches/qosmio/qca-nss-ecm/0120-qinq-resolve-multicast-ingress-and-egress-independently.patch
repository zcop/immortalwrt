-/* The whole Linux multicast route must terminate at one native wired bridge.
- * The bridge MDB supplies the complete receiver set. The driver publishes this
- * exact bitmap only after the QCA8337 ACL has been read back successfully.
+static int ecm_nss_qinq_mc_physical_if(struct net_device *dev)
+{
+	int if_num;
+
+	if (!dev || !netif_running(dev) || !netif_carrier_ok(dev))
+		return -ENODEV;
+	if_num = nss_cmn_get_interface_number_by_dev(dev);
+	if (if_num < NSS_PHYSICAL_IF_START || if_num >= NSS_VIRTUAL_IF_START)
+		return -ENODEV;
+	return if_num;
+}
+
+/* Resolve the multicast route's input device, independently of the LAN
+ * switch. Only the transport link facing a DSA switch needs private tags.
+ * The caller holds RCU.
  */
+static int ecm_nss_qinq_mc_ingress(struct net_device *dev, u32 tags[2])
+{
+	struct net_device *lower = dev;
+	u16 vid = 0;
+
+	tags[0] = ECM_FRONT_END_VLAN_ID_NOT_CONFIGURED;
+	tags[1] = ECM_FRONT_END_VLAN_ID_NOT_CONFIGURED;
+	if (!dev || dev->type != ARPHRD_ETHER || !netif_running(dev) ||
+	    !netif_carrier_ok(dev) || netdev_master_upper_dev_get_rcu(dev))
+		return -EOPNOTSUPP;
+
+	if (is_vlan_dev(dev)) {
+		lower = vlan_dev_real_dev(dev);
+		vid = vlan_dev_vlan_id(dev);
+		if (vlan_dev_vlan_proto(dev) != htons(ETH_P_8021Q) ||
+		    !vid || vid >= VLAN_VID_MASK || is_vlan_dev(lower) ||
+		    netdev_master_upper_dev_get_rcu(lower) ||
+		    __vlan_find_dev_deep_rcu(lower, htons(ETH_P_8021Q), vid) != dev)
+			return -EOPNOTSUPP;
+	}
+
+#if IS_ENABLED(CONFIG_NET_DSA)
+	if (dsa_user_dev_check(lower)) {
+		struct dsa_port *dp, *cpu;
+		u16 svid;
+
+		if (vid || !ecm_nss_qinq_is_port(lower))
+			return -EOPNOTSUPP;
+		dp = dsa_port_from_netdev(lower);
+		if (IS_ERR_OR_NULL(dp))
+			return -ENODEV;
+		cpu = READ_ONCE(dp->cpu_dp);
+		if (!cpu)
+			return -ENODEV;
+		svid = dsa_tag_8021q_standalone_vid(dp);
+		tags[0] = (ETH_P_8021AD << 16) | svid;
+		tags[1] = (ETH_P_8021Q << 16) | svid;
+		return ecm_nss_qinq_mc_physical_if(READ_ONCE(cpu->conduit));
+	}
+#endif
+
+	if (netdev_uses_dsa(lower))
+		return -EOPNOTSUPP;
+	if (vid)
+		tags[0] = (ETH_P_8021Q << 16) | vid;
+	return ecm_nss_qinq_mc_physical_if(lower);
+}
