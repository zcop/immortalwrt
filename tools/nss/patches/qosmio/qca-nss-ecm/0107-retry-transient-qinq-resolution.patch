+/*
+ * Leave a QinQ flow decelerated when the resolver is temporarily unable to
+ * name its leaf. Both interface lists are held here; no NSS rule or
+ * connection ref exists yet.
+ */
+static bool ecm_nss_qinq_ipv4_rule_retry(struct ecm_front_end_connection_instance *feci,
+					 struct nss_ipv4_msg *nim,
+					 struct ecm_db_iface_instance *from_ifaces[],
+					 int32_t from_first,
+					 struct ecm_db_iface_instance *to_ifaces[],
+					 int32_t to_first,
+					 int qinq_from_status, int qinq_to_status,
+					 int32_t from_iface_id, int32_t to_iface_id)
+{
+	if (qinq_from_status != -EAGAIN && qinq_to_status != -EAGAIN)
+		return false;
+	if ((qinq_from_status < 0 && qinq_from_status != -EAGAIN) ||
+	    (qinq_to_status < 0 && qinq_to_status != -EAGAIN) ||
+	    (qinq_from_status != -EAGAIN && from_iface_id < 0) ||
+	    (qinq_to_status != -EAGAIN && to_iface_id < 0))
+		return false;
+	ecm_db_connection_interfaces_deref(from_ifaces, from_first);
+	ecm_db_connection_interfaces_deref(to_ifaces, to_first);
+	kfree(nim);
+	ecm_nss_ipv4_accel_pending_clear(feci, ECM_FRONT_END_ACCELERATION_MODE_DECEL);
+	return true;
+}
