#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# NSS/ECM owns routed acceleration. A parallel nft flowtable bypasses ECM and
# breaks forwarded TCP on the native IPQ50xx QinQ path after a factory reset.
# This default belongs to the opt-in NSS package, not the standard DSA image.
set -e

uci -q get 'firewall.@defaults[0]' >/dev/null || exit 0
# boot sources defaults inside a conditional subshell, where set -e alone
# does not stop failed commands. Leave this script for retry on any failure.
uci -q set 'firewall.@defaults[0].flow_offloading=0' || exit 1
uci -q set 'firewall.@defaults[0].flow_offloading_hw=0' || exit 1
uci -q commit firewall || exit 1
exit 0
