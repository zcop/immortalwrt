#!/bin/sh
# Manual CR881x wired NSS control. No boot autostart or persistent UCI changes.
set -u

module_dir=${CR881X_NSS_MODULE_DIR:-/lib/modules/$(uname -r)}
state_dir=/tmp/cr881x-nss
lock_dir=/var/lock/cr881x-nss.lock
glue=/sys/kernel/debug/qca-dwmac-nss
dsa=/sys/kernel/debug/qca-dsa-nss
ecm=/sys/kernel/debug/ecm
ports='lan1 lan2 lan3 wan'
start_touched=0

say() { printf '%s\n' "cr881x-nss: $*"; }
loaded() { [ -d "/sys/module/$1" ]; }

check_board() {
	[ "$(id -u)" = 0 ] || { say 'run as root'; return 1; }
	[ "$(ubus call system board | jsonfilter -e '@.board_name')" = 'xiaomi,cr881x' ] || {
		say 'this manual controller supports only CR881x'; return 1;
	}
}

check_transport() {
	[ "$(cat /sys/module/yt921x_driver/parameters/experimental_8021q 2>/dev/null)" = Y ] || {
		say 'boot the experimental 802.1Q transport image first'; return 1;
	}
	for dev in eth0 eth1; do
		[ "$(cat "/sys/class/net/$dev/dsa/tagging" 2>/dev/null)" = yt921x-8021q ] || return 1
	done
}

save_ports() {
	: > "$state_dir/ports-before-stop"
	for dev in $ports; do
		[ -r "/sys/class/net/$dev/flags" ] || return 1
		flags=$(cat "/sys/class/net/$dev/flags")
		printf '%s %s\n' "$dev" "$((flags & 1))" >> "$state_dir/ports-before-stop"
	done
}

check_ports() {
	port_error=0
	while read -r dev was_up; do
		flags=$(cat "/sys/class/net/$dev/flags")
		if [ "$((flags & 1))" != "$was_up" ]; then
			say "administrative state changed on $dev; explicit recovery required"
			port_error=1
		fi
	done < "$state_dir/ports-before-stop"
	[ "$port_error" = 0 ]
}

core_started() {
	[ -r "$glue/status" ] &&
		grep -q 'phys_if 0: started dev=eth0 fw_link=up' "$glue/status" &&
		grep -q 'phys_if 1: started dev=eth1 fw_link=up' "$glue/status"
}

network_ready() {
	[ "$(ubus call network.interface.lan status | jsonfilter -e '@.up')" = true ] || return 1
	[ "$(ubus call network.interface.wan status | jsonfilter -e '@.up')" = true ] || return 1
	for dev in eth0 eth1; do
		[ "$(cat "/sys/class/net/$dev/operstate")" = up ] || return 1
		flags=$(cat "/sys/class/net/$dev/flags")
		[ "$((flags & 256))" -ne 0 ] || return 1
	done
	# An active bridge port must finish STP before firmware interfaces bind.
	for dev in lan1 lan2 lan3; do
		if [ "$(cat "/sys/class/net/$dev/carrier" 2>/dev/null)" = 1 ] &&
		   [ -e "/sys/class/net/br-lan/brif/$dev/state" ]; then
			[ "$(cat "/sys/class/net/br-lan/brif/$dev/state")" = 3 ] || return 1
		fi
	done
}

nodes_ready() {
	[ -r "$dsa/status" ] &&
		grep -q 'phys_if=0 ' "$dsa/status" &&
		grep -q 'phys_if=1 ' "$dsa/status" &&
		grep -q 'retries_pending=0' "$dsa/status"
}

wait_for() {
	wait_left=$1
	shift
	while ! "$@"; do
		[ "$wait_left" -gt 0 ] || return 1
		sleep 1
		wait_left=$((wait_left - 1))
	done
}

stop_nss() {
	# Refuse unrelated NSS clients before changing any owner state.
	if loaded qca_nss_drv; then
		for holder in /sys/module/qca_nss_drv/holders/*; do
			[ -e "$holder" ] || continue
			case "${holder##*/}" in
				ecm|qca_dsa_nss|qca_nss_vlan) ;;
				*) say "unsupported active NSS client ${holder##*/}"; return 1 ;;
			esac
		done
	fi
	if loaded qca_dwmac_nss; then
		grep -q 'host_restore_error=' "$glue/status" || {
			say 'updated glue with DSA state restoration is required'; return 1;
		}
	fi
	network_was_ready=0
	if network_ready; then network_was_ready=1; fi
	save_ports || return 1
	if loaded ecm; then
		echo 1 > "$ecm/front_end_ipv4_stop" || return 1
		echo 1 > "$ecm/front_end_ipv6_stop" || return 1
		echo 1 > "$ecm/ecm_db/defunct_all" || return 1
		sleep 1
		rmmod ecm || return 1
	fi
	for mod in qca_dsa_nss qca_nss_vlan; do
		if loaded "$mod"; then rmmod "$mod" || return 1; fi
	done
	restore_error=0
	if loaded qca_dwmac_nss; then
		echo 0 > "$glue/fw_mask" || return 1
		cat "$glue/status" > "$state_dir/last-stop-status"
		if grep -Eq 'host_restore_error=-?[1-9][0-9]*' "$state_dir/last-stop-status"; then
			say 'host DMA/port restore reported an error; see last-stop-status'
			restore_error=1
		fi
	fi
	# Reload both core and glue on the next start; do not reuse old FW rings.
	for mod in qca_nss_drv qca_dwmac_nss; do
		if loaded "$mod"; then rmmod "$mod" || return 1; fi
	done
	check_ports || restore_error=1
	[ "$restore_error" = 0 ] || return 1
	if [ "$network_was_ready" = 1 ]; then
		wait_for 45 network_ready || { say 'host interfaces reopened; network has not settled'; return 1; }
	fi
	say 'host data path restored; NSS modules unloaded'
}

start_nss() {
	check_transport || return 1
	if core_started && loaded ecm && nodes_ready; then
		say 'NSS already running'; return 0
	fi
	for mod in qca_dwmac_nss qca_nss_drv qca_dsa_nss qca_nss_vlan ecm; do
		if loaded "$mod"; then
			say 'partial NSS state; run stop before start'; return 1
		fi
	done
	case "$(ubus call network.interface.wan status | jsonfilter -e '@.proto')" in
		dhcp|static) ;;
		*) say 'this controller currently supports DHCP/static WAN only'; return 1 ;;
	esac
	nft list ruleset > "$state_dir/ruleset-check" || return 1
	if grep -Eq '(flowtable|flow add|flow offload)' "$state_dir/ruleset-check"; then
		say 'disable the existing nft flow offload before starting NSS'; return 1
	fi
	wait_for 45 network_ready || { say 'network has not settled'; return 1; }
	insmod "$module_dir/qca-dwmac-nss.ko" || return 1
	start_touched=1
	grep -q 'host_restore_error=' "$glue/status" || return 1
	echo 0:eth0,1:eth1 > "$glue/ifmap" || return 1
	grep -qx '0:eth0' "$glue/ifmap" && grep -qx '1:eth1' "$glue/ifmap" || return 1
	insmod "$module_dir/qca-nss-drv.ko" || return 1
	[ "$(cat /sys/module/qca_nss_drv/parameters/ipq50xx_core_halt 2>/dev/null)" = Y ] || {
		say 'NSS core local-halt patch is required before arming'; return 1;
	}
	echo 3 > "$glue/fw_mask" || return 1
	wait_for 15 core_started || { say 'firmware takeover failed'; return 1; }
	modprobe qca-nss-vlan && modprobe qca-dsa-nss || return 1
	wait_for 15 nodes_ready || { say 'DSA firmware interfaces not ready'; return 1; }
	modprobe nf_conntrack && modprobe ppp_generic && modprobe pppoe || return 1
	insmod "/lib/modules/$(uname -r)/ecm.ko" front_end_selection=1 || return 1
	echo 1 > "$ecm/ecm_classifier_default/accel_delay_pkts" || return 1
	say 'wired NSS + ECM running; host Wi-Fi drivers untouched'
}

check_board || exit 1
case "${1:-}" in
	start|stop|restart|status) action=$1 ;;
	*) say 'usage: cr881x-nss {start|stop|restart|status}'; exit 2 ;;
esac
if [ "$action" = status ]; then
	if [ -r "$glue/status" ]; then cat "$glue/status"; else say 'host path (NSS glue absent)'; fi
	if [ -r "$dsa/status" ]; then cat "$dsa/status"; fi
	exit 0
fi
umask 077
mkdir -p "$state_dir" /var/lock || exit 1
mkdir "$lock_dir" || { say 'another operation holds the lock'; exit 1; }
trap 'rmdir "$lock_dir"' EXIT
trap 'exit 1' INT TERM
if [ "$action" != start ]; then stop_nss || exit 1; fi
if [ "$action" != stop ]; then
	if ! start_nss; then
		if [ "$start_touched" = 1 ]; then
			say 'start failed; attempting host-path cleanup'
			stop_nss || say 'cleanup incomplete; inspect status through the console'
		fi
		exit 1
	fi
fi
