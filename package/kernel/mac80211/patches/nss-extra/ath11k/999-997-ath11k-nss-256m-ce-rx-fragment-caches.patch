From: fanha99 <fanha99@hotmail.com>
Subject: [PATCH] wifi: ath11k: give each CE pipe its own RX fragment cache in the NSS 256 MiB profile

The CE RX buffers come from dev_alloc_skb(), that is from the shared
per-CPU page-fragment cache, 13 buffers to a 32 KiB chunk, and a chunk
is only freed when all of its buffers are. The pipes refill at very
different rates: CE1 (HTT) all the time, CE2 (WMI) and CE5 (pktlog)
rarely. A refill of a slow pipe lands in a chunk of HTT buffers and
keeps it alive until that pipe wraps. On a Xiaomi CR8806 (IPQ5018 +
QCN6122, NSS Wi-Fi offload) page_owner put 16-18 MiB on CE RX refills
nine minutes after boot, against ~4 MiB of buffers posted.

In the NSS 256 MiB profile, allocate each pipe's RX buffers from a
private cache, under the ce_lock that already serialises the refill,
and drain it when the pipe is cleaned up. Other configurations keep
dev_alloc_skb().

Signed-off-by: fanha99 <fanha99@hotmail.com>
---
--- a/drivers/net/wireless/ath/ath11k/ce.c
+++ b/drivers/net/wireless/ath/ath11k/ce.c
@@ -318,6 +318,38 @@ exit:
 	return ret;
 }
 
+/* The pipes refill at very different rates: CE1 (HTT) all the time,
+ * CE2 (WMI) and CE5 (pktlog) rarely. From the shared per-CPU fragment
+ * cache, one buffer of a slow pipe keeps a whole 32 KiB chunk of HTT
+ * buffers alive until that pipe wraps. Give each pipe its own cache.
+ */
+static struct sk_buff *ath11k_ce_rx_alloc_skb(struct ath11k_ce_pipe *pipe)
+{
+	struct sk_buff *skb;
+	unsigned int len;
+	void *data;
+
+	if (!ath11k_nss_256m_enabled(pipe->ab))
+		return dev_alloc_skb(pipe->buf_sz);
+
+	lockdep_assert_held(&pipe->ab->ce.ce_lock);
+
+	len = SKB_HEAD_ALIGN(pipe->buf_sz + NET_SKB_PAD);
+	data = page_frag_alloc(&pipe->rx_frag_cache, len,
+			       GFP_ATOMIC | __GFP_NOWARN);
+	if (!data)
+		return NULL;
+
+	skb = build_skb(data, len);
+	if (!skb) {
+		page_frag_free(data);
+		return NULL;
+	}
+	skb_reserve(skb, NET_SKB_PAD);
+
+	return skb;
+}
+
 static int ath11k_ce_rx_post_pipe(struct ath11k_ce_pipe *pipe)
 {
 	struct ath11k_base *ab = pipe->ab;
@@ -330,7 +362,7 @@ static int ath11k_ce_rx_post_pipe(struct
 
 	spin_lock_bh(&ab->ce.ce_lock);
 	while (pipe->rx_buf_needed) {
-		skb = dev_alloc_skb(pipe->buf_sz);
+		skb = ath11k_ce_rx_alloc_skb(pipe);
 		if (!skb) {
 			ret = -ENOMEM;
 			goto exit;
@@ -871,6 +903,9 @@ static void ath11k_ce_rx_pipe_cleanup(st
 				 skb->len + skb_tailroom(skb), DMA_FROM_DEVICE);
 		dev_kfree_skb_any(skb);
 	}
+
+	/* Also when NSS was turned off for recovery: no-op if unused */
+	page_frag_cache_drain(&pipe->rx_frag_cache);
 }
 
 static void ath11k_ce_shadow_config(struct ath11k_base *ab)
--- a/drivers/net/wireless/ath/ath11k/ce.h
+++ b/drivers/net/wireless/ath/ath11k/ce.h
@@ -7,6 +7,8 @@
 #ifndef ATH11K_CE_H
 #define ATH11K_CE_H
 
+#include <linux/page_frag_cache.h>
+
 #define CE_COUNT_MAX 12
 
 /* Byte swap data words */
@@ -180,6 +182,8 @@ struct ath11k_ce_pipe {
 	struct ath11k_ce_ring *dest_ring;
 	struct ath11k_ce_ring *status_ring;
 	u64 timestamp;
+	/* NSS 256 MiB profile: RX buffers of this pipe only, under ce_lock */
+	struct page_frag_cache rx_frag_cache;
 };
 
 struct ath11k_ce {
