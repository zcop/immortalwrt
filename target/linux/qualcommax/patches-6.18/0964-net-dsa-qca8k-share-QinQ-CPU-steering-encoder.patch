Share the CPU-only SVID/CVID steering encoder between native and customer
domains. Keep front-panel forwarding in the existing VTU/FDB path and
validate conduit selectors before indexing ports or shifting CPU bits.

--- a/drivers/net/dsa/qca/qca8k-qinq.c
+++ b/drivers/net/dsa/qca/qca8k-qinq.c
@@ -175,13 +175,31 @@
 	return 0;
 }
 
+/* CPU transport steering only. Native domains and customer VLANs share the
+ * same exact CPU/SVID/CVID match; front-panel forwarding stays in VTU/FDB.
+ */
+static int qca8k_qinq_steer(struct qca8k_priv *priv, int slot, int port,
+			  int cpu, u16 cvid)
+{
+	u32 value[5] = {}, action[3] = {};
+	u32 mask[5] = { 0, 0, 0xff0fff00, 0xf, 0xff };
+	u16 svid;
+
+	if (port < 1 || port > 4 || (cpu != 0 && cpu != 5))
+		return -EOPNOTSUPP;
+	svid = dsa_tag_8021q_standalone_vid(dsa_to_port(priv->ds, port));
+	value[2] = (svid << 8) | ((u32)(cvid & 0xff) << 24);
+	value[3] = 0xc1000000 | (cvid >> 8);
+	value[4] = BIT(cpu);
+	action[1] = (BIT(port) & 7) << 29;
+	action[2] = BIT(4) | (BIT(port) >> 3);
+
+	return qca8k_qinq_rule(priv, slot, value, mask, action);
+}
