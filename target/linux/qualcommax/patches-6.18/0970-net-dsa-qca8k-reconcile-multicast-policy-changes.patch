+/* The bounded QinQ flow matches a native incoming VIF and one native output.
+ * NSS enforces the ordinary routed TTL check, so reject custom thresholds.
+ */
+int ipmr_qinq_ipv4_mc_route(struct net *net, __be32 origin, __be32 group,
+			   int input, u32 *output)
+{
+	const struct vif_device *vif;
+	struct mfc_cache *cache;
+	struct mr_table *mrt;
+	int i, parent, ret = -EOPNOTSUPP;
+	u32 found = 0;
+
+	rcu_read_lock();
+	mrt = ipmr_get_table(net, RT_TABLE_DEFAULT);
+	if (!mrt)
+		goto out;
+	spin_lock_bh(&mrt_lock);
+	cache = ipmr_cache_find(mrt, origin, group);
+	if (!cache)
+		goto unlock;
+	parent = cache->_c.mfc_parent;
+	if (parent >= MAXVIFS || !VIF_EXISTS(mrt, parent))
+		goto unlock;
+	vif = &mrt->vif_table[parent];
+	if (vif->dev->ifindex != input || (vif->flags & (VIFF_TUNNEL | VIFF_REGISTER)))
+		goto unlock;
+	for (i = 0; i < cache->_c.mfc_un.res.maxvif; i++) {
+		u8 ttl = cache->_c.mfc_un.res.ttls[i];
+
+		if (ttl == 255 || !ttl)
+			continue;
+		if (ttl != 1 || i == parent || found || !VIF_EXISTS(mrt, i))
+			goto unlock;
+		vif = &mrt->vif_table[i];
+		if (vif->flags & (VIFF_TUNNEL | VIFF_REGISTER))
+			goto unlock;
+		found = vif->dev->ifindex;
+	}
+	if (found) {
+		*output = found;
+		ret = 0;
+	}
+unlock:
+	spin_unlock_bh(&mrt_lock);
+out:
+	rcu_read_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ipmr_qinq_ipv4_mc_route);
