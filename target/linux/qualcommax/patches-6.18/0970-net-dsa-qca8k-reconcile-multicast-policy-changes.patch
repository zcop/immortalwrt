+static void qca8k_qinq_mc_queue(struct qca8k_priv *priv, __be32 group)
+{
+	int i;
+
+	if (!READ_ONCE(priv->qinq_mc_watch))
+		return;
+	if (group) {
+		spin_lock_bh(&priv->qinq_mc_pending_lock);
+		for (i = 0; i < ARRAY_SIZE(priv->qinq_mc_pending); i++) {
+			if (!priv->qinq_mc_pending[i] || priv->qinq_mc_pending[i] == group) {
+				priv->qinq_mc_pending[i] = group;
+				break;
+			}
+		}
+		spin_unlock_bh(&priv->qinq_mc_pending_lock);
+	}
+	mod_delayed_work(system_wq, &priv->qinq_mc_work, 0);
+}
+
+/* Changes to multicast policy can originate under the bridge spinlock. */
+static int qca8k_qinq_mc_policy_event(struct notifier_block *nb,
+				     unsigned long event, void *ptr)
+{
+	struct qca8k_priv *priv = container_of(nb, struct qca8k_priv, qinq_mc_nb);
+
+	if (event == BR_QINQ_MC_POLICY)
+		qca8k_qinq_mc_queue(priv, *(__be32 *)ptr);
+	return NOTIFY_DONE;
+}
+
+static void qca8k_qinq_mc_reconcile(struct work_struct *work)
+{
+	struct qca8k_priv *priv = container_of(to_delayed_work(work),
+					      struct qca8k_priv, qinq_mc_work);
+	struct dsa_switch *ds = priv->ds;
+	__be32 pending[QCA8K_QINQ_MAX_MC];
+	int i;
+
+	/* DSA teardown can cancel this work while it holds RTNL. */
+	if (!READ_ONCE(priv->qinq_mc_watch))
+		return;
+	if (!rtnl_trylock()) {
+		mod_delayed_work(system_wq, &priv->qinq_mc_work, 1);
+		return;
+	}
+	spin_lock_bh(&priv->qinq_mc_pending_lock);
+	memcpy(pending, priv->qinq_mc_pending, sizeof(pending));
+	memset(priv->qinq_mc_pending, 0, sizeof(priv->qinq_mc_pending));
+	spin_unlock_bh(&priv->qinq_mc_pending_lock);
+
+	for (i = 0; i < ARRAY_SIZE(priv->qinq_mc); i++) {
+		struct qca8k_qinq_mc *mc = &priv->qinq_mc[i];
+		struct dsa_port *dp;
+		struct dsa_db db = { .type = DSA_DB_BRIDGE };
+
+		if (!mc->group)
+			continue;
+		dsa_switch_for_each_user_port(dp, ds) {
+			unsigned int num;
+
+			if (!dp->bridge || !dp->cpu_dp || dp->cpu_dp->index != mc->cpu)
+				continue;
+			num = dsa_port_bridge_num_get(dp);
+			if (num && dsa_tag_8021q_bridge_vid(num) == mc->cvid) {
+				db.bridge = *dp->bridge;
+				break;
+			}
+		}
+		if (!db.bridge.dev) {
+			qca8k_qinq_mc_remove(priv, mc);
+			continue;
+		}
+		qca8k_qinq_ipv4_mc_sync(ds, db, mc->group);
+	}
+	for (i = 0; i < ARRAY_SIZE(pending); i++) {
+		struct dsa_port *dp;
+		unsigned long seen = 0;
+
+		if (!pending[i])
+			continue;
+		dsa_switch_for_each_user_port(dp, ds) {
+			unsigned int num = dsa_port_bridge_num_get(dp);
+			struct dsa_db db = { .type = DSA_DB_BRIDGE };
+
+			if (!dp->bridge || !num || num > DSA_TAG_8021Q_MAX_NUM_BRIDGES ||
+			    (seen & BIT(num)))
+				continue;
+			seen |= BIT(num);
+			db.bridge = *dp->bridge;
+			qca8k_qinq_ipv4_mc_sync(ds, db, pending[i]);
+		}
+	}
+	rtnl_unlock();
 }
 
