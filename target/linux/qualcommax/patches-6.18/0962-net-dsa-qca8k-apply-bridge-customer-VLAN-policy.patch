 	err = qca8k_update_port_member(priv, port, bridge.dev, false);
 	if (err)
 		dev_err(priv->dev,
@@ -1101,12 +1118,18 @@
 	int ret;
 
 	if (priv->qinq) {
-		if (vlan_filtering && dsa_port_bridge_dev_get(dsa_to_port(ds, port))) {
-			NL_SET_ERR_MSG_MOD(extack, "QCA QinQ: VLAN-aware bridge policy is pending");
-			return -EOPNOTSUPP;
+		struct net_device *br = dsa_port_bridge_dev_get(dsa_to_port(ds, port));
+		u16 proto;
+
+		if (!br)
+			return 0; /* Standalone VLAN uppers keep fallback lookup. */
+		if (br_vlan_get_proto(br, &proto) || proto != ETH_P_8021Q) {
+			NL_SET_ERR_MSG_MOD(extack, "QCA QinQ bridge VLANs require 802.1Q");
+			return -EINVAL;
 		}
-		return 0; /* Keep fallback lookup for the QinQ parser. */
-	}
+		return qca8k_qinq_port_vlan_filtering(ds, port, vlan_filtering);
+	}
+
 	if (vlan_filtering) {
 		ret = qca8k_rmw(priv, QCA8K_PORT_LOOKUP_CTRL(port),
 				QCA8K_PORT_LOOKUP_VLAN_MODE_MASK,
@@ -1132,7 +1155,7 @@
 	if (priv->qinq) {
 		ret = qca8k_qinq_customer_add(ds, port, vlan->vid, vlan->flags);
 		if (ret == -EOPNOTSUPP || ret == -ENOSPC)
-			NL_SET_ERR_MSG_MOD(extack, "QCA QinQ: standalone tagged VLAN or ACL capacity exceeded");
+			NL_SET_ERR_MSG_MOD(extack, "QCA QinQ: invalid customer VLAN or ACL capacity exceeded");
 		return ret;
 	}
 	ret = qca8k_vlan_add(priv, port, vlan->vid, untagged);
@@ -1429,6 +1452,11 @@
 
 	if (!priv->qinq)
 		return -EOPNOTSUPP;
+	if (dsa_is_user_port(ds, port) && (priv->qinq_vlan_filtering & BIT(port))) {
+		if (pvid)
+			priv->qinq_native_vid[port] = vid;
+		return 0; /* Private domain is remembered, not admitted in aware mode. */
+	}
 	ret = qca8k_vlan_add(priv, port, vid, flags & BRIDGE_VLAN_INFO_UNTAGGED);
 	if (ret)
 		goto fail;
@@ -1456,6 +1484,11 @@
 
 	if (!priv->qinq)
 		return -EOPNOTSUPP;
+	if (dsa_is_user_port(ds, port) && (priv->qinq_vlan_filtering & BIT(port))) {
+		if (priv->qinq_native_vid[port] == vid)
+			priv->qinq_native_vid[port] = 0;
+		return 0;
+	}
 	if (priv->qinq_native_vid[port] == vid) {
 		ret = qca8k_qinq_block_native(priv, port);
 		if (ret)
