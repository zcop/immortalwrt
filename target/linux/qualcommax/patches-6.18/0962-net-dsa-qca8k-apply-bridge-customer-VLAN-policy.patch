From: Zcop <zcop@users.noreply.github.com>
Subject: [PATCH] net: dsa: qca QinQ: apply bridge customer VLAN policy

Keep exact port SVIDs while using bridge customer VLAN membership and PVIDs.
Cache bridge VLAN objects when filtering is off; withdraw native admission
before installing customer domains. Retain customer tags for the Linux bridge.

--- a/drivers/net/dsa/qca/qca8k.h
+++ b/drivers/net/dsa/qca/qca8k.h
@@ -450,9 +450,9 @@
 /* Each entry grants one exact user-port/customer-VID egress path. */
 #define QCA8K_QINQ_MAX_VLANS 56
 struct qca8k_qinq_vlan {
-	u16 vid;
+	u16 vid, flags;
 	u8 port, cpu, slot;
-	bool used;
+	bool used, bridge, installed;
 };
 
 struct qca8k_priv {
@@ -473,6 +473,8 @@
 	struct qca8k_qinq_vlan qinq_vlans[QCA8K_QINQ_MAX_VLANS];
 	unsigned long qinq_host_vlans[2][BITS_TO_LONGS(VLAN_N_VID)];
 	u16 qinq_native_vid[QCA8K_NUM_PORTS];
+	u16 qinq_pvid[QCA8K_NUM_PORTS];
+	u8 qinq_vlan_filtering;
 	struct qca8k_ports_config ports_config;
 	struct regmap *regmap;
 	struct mii_bus *bus;
@@ -522,6 +524,8 @@
 int qca8k_qinq_setup(struct dsa_switch *ds);
 void qca8k_qinq_teardown(struct dsa_switch *ds);
 int qca8k_qinq_conduit(struct qca8k_priv *priv, int port, int cpu);
+void qca8k_qinq_customer_bridge_leave(struct dsa_switch *ds, int port);
+int qca8k_qinq_port_vlan_filtering(struct dsa_switch *ds, int port, bool enable);
 bool qca8k_qinq_customer_busy(struct qca8k_priv *priv, int port);
 int qca8k_qinq_check_conduit(struct qca8k_priv *priv, int port, int cpu);
 void qca8k_qinq_fault(struct qca8k_priv *priv, int port);
--- a/drivers/net/dsa/qca/qca8k-qinq.c
+++ b/drivers/net/dsa/qca/qca8k-qinq.c
@@ -187,6 +187,8 @@
 	ret = qca8k_qinq_check_conduit(priv, port, cpu);
 	if (ret)
 		return ret;
+	if (priv->qinq_vlan_filtering & BIT(port))
+		return 0; /* Native admission stays withdrawn in aware mode. */
 	/* Native steering must not admit arbitrary customer C-VIDs. Slot94
 	 * grants the selected standalone upper after both VTU objects exist.
 	 */
@@ -296,7 +298,7 @@
 	for (i = 0; i < QCA8K_QINQ_MAX_VLANS; i++) {
 		struct qca8k_qinq_vlan *v = &priv->qinq_vlans[i];
 
-		if (!v->used || v->cpu != cpu || v->vid != vid)
+		if (!v->used || !v->installed || v->cpu != cpu || v->vid != vid)
 			continue;
 		qca8k_qinq_customer_rule(priv, v, false);
 		qca8k_qinq_fault(priv, v->port);
@@ -311,7 +313,7 @@
 	for (i = 0; i < QCA8K_QINQ_MAX_VLANS; i++) {
 		struct qca8k_qinq_vlan *v = &priv->qinq_vlans[i];
 
-		if (!v->used || v->cpu != cpu || v->vid != vid)
+		if (!v->used || !v->installed || v->cpu != cpu || v->vid != vid)
 			continue;
 		ret = qca8k_qinq_customer_rule(priv, v, enable);
 		if (ret) {
@@ -320,6 +322,74 @@
 		}
 	}
 	return 0;
+}
+
+static int qca8k_qinq_set_pvid(struct qca8k_priv *priv, int port, u16 vid)
+{
+	int i, ret;
+
+	ret = qca8k_rmw(priv, QCA8K_REG_PORT_VLAN_CTRL0(port),
+			QCA8K_PORT_VLAN_CVID_MASK, QCA8K_PORT_VLAN_CVID(vid));
+	if (ret)
+		return ret;
+	priv->qinq_pvid[port] = vid;
+	for (i = 0; i < QCA8K_QINQ_MAX_VLANS; i++) {
+		struct qca8k_qinq_vlan *other = &priv->qinq_vlans[i];
+
+		if (vid && other->used && other->port == port && other->vid != vid)
+			other->flags &= ~BRIDGE_VLAN_INFO_PVID;
+	}
+	return 0;
+}
+
+static void qca8k_qinq_customer_remember(struct qca8k_priv *priv,
+				      struct qca8k_qinq_vlan *v, u16 flags)
+{
+	int i;
+
+	v->flags = flags;
+	if (!(flags & BRIDGE_VLAN_INFO_PVID))
+		return;
+	for (i = 0; i < QCA8K_QINQ_MAX_VLANS; i++) {
+		struct qca8k_qinq_vlan *other = &priv->qinq_vlans[i];
+
+		if (other != v && other->used && other->port == v->port)
+			other->flags &= ~BRIDGE_VLAN_INFO_PVID;
+	}
+}
+
+static int qca8k_qinq_customer_install(struct qca8k_priv *priv,
+				      struct qca8k_qinq_vlan *v, u16 flags)
+{
+	bool was_installed = v->installed;
+	int ret;
+
+	/* Tag/PVID changes must not leave the old egress grant usable. */
+	if (was_installed) {
+		ret = qca8k_qinq_customer_rule(priv, v, false);
+		if (ret)
+			return ret;
+	}
+	ret = qca8k_vlan_add(priv, v->port, v->vid,
+			      flags & BRIDGE_VLAN_INFO_UNTAGGED);
+	if (ret)
+		return ret;
+	v->installed = true;
+	if (v->bridge && (priv->qinq_vlan_filtering & BIT(v->port))) {
+		if (flags & BRIDGE_VLAN_INFO_PVID)
+			ret = qca8k_qinq_set_pvid(priv, v->port, v->vid);
+		else if (priv->qinq_pvid[v->port] == v->vid)
+			ret = qca8k_qinq_set_pvid(priv, v->port, 0);
+		if (ret)
+			return ret;
+	}
+	v->flags = flags;
+	if (!test_bit(v->vid, priv->qinq_host_vlans[v->cpu == 5]))
+		return 0;
+	ret = qca8k_qinq_customer_rule(priv, v, true);
+	if (ret && !was_installed && !qca8k_vlan_del(priv, v->port, v->vid))
+		v->installed = false;
+	return ret;
 }
 
 int qca8k_qinq_customer_add(struct dsa_switch *ds, int port, u16 vid, u16 flags)
@@ -332,7 +402,7 @@
 
 	if (!vid)
 		return 0;
-	if (flags || !dsa_qca_qinq_customer_vid_valid(ds, vid))
+	if (!dsa_qca_qinq_customer_vid_valid(ds, vid))
 		return -EOPNOTSUPP;
 	if (!dsa_is_user_port(ds, port)) {
 		if (port != 0 && port != 5)
@@ -358,11 +428,22 @@
 	if (priv->qinq_fault_map & BIT(port))
 		return -EIO;
 	dp = dsa_to_port(ds, port);
-	if (dp->bridge || netdev_master_upper_dev_get(dp->user))
+	if (netdev_master_upper_dev_get(dp->user) != dsa_port_bridge_dev_get(dp))
 		return -EOPNOTSUPP;
+	if (!dp->bridge && flags)
+		return -EOPNOTSUPP;
+	flags &= BRIDGE_VLAN_INFO_PVID | BRIDGE_VLAN_INFO_UNTAGGED;
 	v = qca8k_qinq_customer_find(priv, port, vid);
-	if (v)
-		return 0;
+	if (v) {
+		if (v->bridge && !(priv->qinq_vlan_filtering & BIT(port))) {
+			qca8k_qinq_customer_remember(priv, v, flags);
+			return 0;
+		}
+		ret = qca8k_qinq_customer_install(priv, v, flags);
+		if (ret)
+			goto fault;
+		return 0;
+	}
 	for (i = 0; i < QCA8K_QINQ_MAX_VLANS; i++)
 		if (!priv->qinq_vlans[i].used)
 			break;
@@ -371,19 +452,18 @@
 	slot = qca8k_qinq_customer_slot(priv);
 	if (slot < 0)
 		return slot;
-	ret = qca8k_vlan_add(priv, port, vid, false);
-	if (ret)
-		goto fault;
 	v = &priv->qinq_vlans[i];
 	*v = (struct qca8k_qinq_vlan) {
 		.vid = vid, .port = port, .cpu = dp->cpu_dp->index,
-		.slot = slot, .used = true,
+		.slot = slot, .used = true, .bridge = !!dp->bridge, .flags = flags,
 	};
-	if (!test_bit(vid, priv->qinq_host_vlans[v->cpu == 5]))
-		return 0;
-	ret = qca8k_qinq_customer_rule(priv, v, true);
+	if (v->bridge && !(priv->qinq_vlan_filtering & BIT(port))) {
+		qca8k_qinq_customer_remember(priv, v, flags);
+		return 0;
+	}
+	ret = qca8k_qinq_customer_install(priv, v, flags);
 	if (ret) {
-		if (!qca8k_vlan_del(priv, port, vid))
+		if (!v->installed)
 			memset(v, 0, sizeof(*v));
 		goto fault;
 	}
@@ -423,13 +503,126 @@
 	v = qca8k_qinq_customer_find(priv, port, vid);
 	if (!v)
 		return 0;
-	ret = qca8k_qinq_customer_rule(priv, v, false);
+	if (v->installed) {
+		ret = qca8k_qinq_customer_rule(priv, v, false);
+		if (ret)
+			goto fault;
+		if ((priv->qinq_vlan_filtering & BIT(port)) && priv->qinq_pvid[port] == vid) {
+			ret = qca8k_qinq_set_pvid(priv, port, 0);
+			if (ret)
+				goto fault;
+		}
+		ret = qca8k_vlan_del(priv, port, vid);
+		if (ret)
+			goto fault;
+	}
+	memset(v, 0, sizeof(*v));
+	return 0;
+fault:
+	qca8k_qinq_fault(priv, port);
+	return ret;
+}
+
+void qca8k_qinq_customer_bridge_leave(struct dsa_switch *ds, int port)
+{
+	struct qca8k_priv *priv = ds->priv;
+	int i;
+
+	for (i = 0; i < QCA8K_QINQ_MAX_VLANS; i++) {
+		struct qca8k_qinq_vlan *v = &priv->qinq_vlans[i];
+
+		if (v->used && v->bridge && v->port == port)
+			qca8k_qinq_customer_del(ds, port, v->vid);
+	}
+}
+
+/* DSA retains bridge VLAN objects while filtering is disabled. Keep their
+ * logical permissions cached, and reconcile hardware on every transition.
+ * The private bit is required because DSA updates dp->vlan_filtering later.
+ */
+int qca8k_qinq_port_vlan_filtering(struct dsa_switch *ds, int port, bool enable)
+{
+	struct qca8k_priv *priv = ds->priv;
+	struct dsa_port *dp = dsa_to_port(ds, port);
+	u16 native = priv->qinq_native_vid[port];
+	int i, ret;
+
+	if (!dsa_is_user_port(ds, port))
+		return -EOPNOTSUPP;
+	/* An MDIO/ACL failure leaves a deliberately quarantined port. Never
+	 * report a successful retry from partially updated transition state.
+	 * Only a complete switch reinitialization can clear this fault.
+	 */
+	if (priv->qinq_fault_map & BIT(port))
+		return -EIO;
+	if (!!(priv->qinq_vlan_filtering & BIT(port)) == enable)
+		return 0;
+	if (enable) {
+		ret = qca8k_qinq_block_native(priv, port);
+		if (ret)
+			goto fault;
+		if (native) {
+			ret = qca8k_vlan_del(priv, port, native);
+			if (ret)
+				goto fault;
+		}
+		priv->qinq_vlan_filtering |= BIT(port);
+		ret = qca8k_qinq_set_pvid(priv, port, 0);
+		if (ret)
+			goto fault;
+		ret = qca8k_rmw(priv, QCA8K_PORT_LOOKUP_CTRL(port),
+				QCA8K_PORT_LOOKUP_VLAN_MODE_MASK,
+				QCA8K_PORT_LOOKUP_VLAN_MODE_SECURE);
+		if (ret)
+			goto fault;
+		for (i = 0; i < QCA8K_QINQ_MAX_VLANS; i++) {
+			struct qca8k_qinq_vlan *v = &priv->qinq_vlans[i];
+
+			if (!v->used || v->port != port || !v->bridge)
+				continue;
+			ret = qca8k_qinq_customer_install(priv, v, v->flags);
+			if (ret)
+				goto fault;
+		}
+		return 0;
+	}
+	for (i = 0; i < QCA8K_QINQ_MAX_VLANS; i++) {
+		struct qca8k_qinq_vlan *v = &priv->qinq_vlans[i];
+
+		if (!v->used || v->port != port || !v->bridge || !v->installed)
+			continue;
+		ret = qca8k_qinq_customer_rule(priv, v, false);
+		if (ret)
+			goto fault;
+		ret = qca8k_vlan_del(priv, port, v->vid);
+		if (ret)
+			goto fault;
+		v->installed = false;
+	}
+	priv->qinq_vlan_filtering &= ~BIT(port);
+	priv->qinq_pvid[port] = 0;
+	ret = qca8k_rmw(priv, QCA8K_PORT_LOOKUP_CTRL(port),
+			QCA8K_PORT_LOOKUP_VLAN_MODE_MASK,
+			QCA8K_PORT_LOOKUP_VLAN_MODE_FALLBACK);
 	if (ret)
 		goto fault;
-	ret = qca8k_vlan_del(priv, port, vid);
+	if (!native) {
+		ret = qca8k_rmw(priv, QCA8K_REG_PORT_VLAN_CTRL0(port),
+				QCA8K_PORT_VLAN_CVID_MASK, 0);
+		if (ret)
+			goto fault;
+		return 0;
+	}
+	ret = qca8k_vlan_add(priv, port, native, true);
 	if (ret)
 		goto fault;
-	memset(v, 0, sizeof(*v));
+	ret = qca8k_rmw(priv, QCA8K_REG_PORT_VLAN_CTRL0(port),
+			QCA8K_PORT_VLAN_CVID_MASK, QCA8K_PORT_VLAN_CVID(native));
+	if (ret)
+		goto fault;
+	ret = qca8k_qinq_conduit(priv, port, dp->cpu_dp->index);
+	if (ret)
+		goto fault;
 	return 0;
 fault:
 	qca8k_qinq_fault(priv, port);
@@ -462,6 +655,8 @@
 			qca8k_qinq_acl_write(priv, v->slot, QINQ_ACL_MASKS, disabled, 5);
 	}
 	mutex_unlock(&priv->reg_mutex);
+	priv->qinq_vlan_filtering = 0;
+	memset(priv->qinq_pvid, 0, sizeof(priv->qinq_pvid));
 	memset(priv->qinq_vlans, 0, sizeof(priv->qinq_vlans));
 	memset(priv->qinq_host_vlans, 0, sizeof(priv->qinq_host_vlans));
 	priv->qinq_acl_owned = false;
@@ -567,6 +762,7 @@
 		goto fail;
 	ds->max_num_bridges = DSA_TAG_8021Q_MAX_NUM_BRIDGES;
 	ds->needs_standalone_vlan_filtering = true;
+	ds->configure_vlan_while_not_filtering = true;
 	rtnl_lock();
 	ret = dsa_tag_8021q_register(ds, htons(ETH_P_8021AD));
 	rtnl_unlock();
