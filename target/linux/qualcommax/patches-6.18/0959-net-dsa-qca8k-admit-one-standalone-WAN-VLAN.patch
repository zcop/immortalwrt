 {
 	u32 reg;
@@ -428,7 +428,7 @@
 	return ret;
 }
 
-static int qca8k_vlan_del(struct qca8k_priv *priv, u8 port, u16 vid)
+int qca8k_vlan_del(struct qca8k_priv *priv, u8 port, u16 vid)
 {
 	u32 reg, mask;
 	int ret, i;
@@ -1097,8 +1097,8 @@
 	int ret;
 
 	if (priv->qinq) {
-		if (vlan_filtering) {
-			NL_SET_ERR_MSG_MOD(extack, "QCA QinQ: customer VLAN policy is pending");
+		if (vlan_filtering && dsa_port_bridge_dev_get(dsa_to_port(ds, port))) {
+			NL_SET_ERR_MSG_MOD(extack, "QCA QinQ: VLAN-aware bridge policy is pending");
 			return -EOPNOTSUPP;
 		}
 		return 0; /* Keep fallback lookup for the QinQ parser. */
@@ -1126,8 +1126,10 @@
 	int ret;
 
 	if (priv->qinq) {
-		NL_SET_ERR_MSG_MOD(extack, "QCA QinQ: customer VLAN policy is pending");
-		return -EOPNOTSUPP;
+		ret = qca8k_qinq_customer_add(ds, port, vlan->vid, vlan->flags);
+		if (ret == -EOPNOTSUPP || ret == -ENOSPC)
+			NL_SET_ERR_MSG_MOD(extack, "QCA QinQ: one standalone WAN customer VLAN is supported");
+		return ret;
 	}
 	ret = qca8k_vlan_add(priv, port, vlan->vid, untagged);
 	if (ret) {
@@ -1156,6 +1158,8 @@
 	struct qca8k_priv *priv = ds->priv;
 	int ret;
 
+	if (priv->qinq)
+		return qca8k_qinq_customer_del(ds, port, vlan->vid);
 	ret = qca8k_vlan_del(priv, port, vlan->vid);
 	if (ret)
 		dev_err(priv->dev, "Failed to delete VLAN from port %d (%d)", port, ret);
@@ -1430,6 +1434,12 @@
 		if (ret)
 			goto fail;
 		priv->qinq_native_vid[port] = vid;
+		if (port == 4) {
+			ret = qca8k_qinq_conduit(priv, port,
+					       dsa_to_port(ds, port)->cpu_dp->index);
+			if (ret)
+				goto fail;
+		}
 	}
 	return 0;
 fail:
@@ -1444,6 +1454,11 @@
 
 	if (!priv->qinq)
 		return -EOPNOTSUPP;
+	if (priv->qinq_native_vid[port] == vid) {
+		ret = qca8k_qinq_block_native(priv, port);
+		if (ret)
+			return ret;
+	}
 	ret = qca8k_vlan_del(priv, port, vid);
 	if (ret) {
 		qca8k_qinq_fault(priv, port);
--- a/drivers/net/dsa/qca/qca8k-8xxx.c
+++ b/drivers/net/dsa/qca/qca8k-8xxx.c
@@ -1835,6 +1835,13 @@
 	if (priv->qinq && (netif_is_lag_master(master) || !master->dsa_ptr ||
 			   master->dsa_ptr->ds != ds))
 		return -EOPNOTSUPP;
+
+	/* Reject a CPU transition before touching either membership table. */
+	if (priv->qinq) {
+		ret = qca8k_qinq_check_conduit(priv, port, master->dsa_ptr->index);
+		if (ret)
+			return ret;
+	}
 
 	/* With LAG of CPU port, compose the mask for port LOOKUP MEMBER */
 	if (netif_is_lag_master(master)) {
