From: Adriel Santos <adriel@adriel.eu>
Subject: [PATCH] net: dsa: tag_8021q: unwind failed VLAN programming

Undo earlier port memberships if a later port fails during a VLAN add.

If setting up a later port fails during registration, tear down only
the ports that were already set up, so their standalone VLANs and the
conduit's RX filters are not left behind. Then free any VLAN reference
a failed delete left on the context, and clear the switch pointer
before freeing it, so the driver never sees a stale context.

Signed-off-by: Adriel Santos <adriel@adriel.eu>
Assisted-by: Claude
---
--- a/net/dsa/tag_8021q.c
+++ b/net/dsa/tag_8021q.c
@@ -217,7 +217,7 @@ dsa_port_tag_8021q_vlan_match(struct dsa
 int dsa_switch_tag_8021q_vlan_add(struct dsa_switch *ds,
 				  struct dsa_notifier_tag_8021q_vlan_info *info)
 {
-	struct dsa_port *dp;
+	struct dsa_port *dp, *other;
 	int err;
 
 	/* Since we use dsa_broadcast(), there might be other switches in other
@@ -239,11 +239,21 @@ int dsa_switch_tag_8021q_vlan_add(struct
 			err = dsa_port_do_tag_8021q_vlan_add(dp, info->vid,
 							     flags);
 			if (err)
-				return err;
+				goto unwind;
 		}
 	}
 
 	return 0;
+
+unwind:
+	/* Undo ports whose add succeeded before a later port failed. */
+	dsa_switch_for_each_port(other, ds) {
+		if (other == dp)
+			break;
+		if (dsa_port_tag_8021q_vlan_match(other, info))
+			dsa_port_do_tag_8021q_vlan_del(other, info->vid);
+	}
+	return err;
 }
 
 int dsa_switch_tag_8021q_vlan_del(struct dsa_switch *ds,
@@ -398,11 +408,17 @@ static int dsa_tag_8021q_setup(struct ds
 			dev_err(ds->dev,
 				"Failed to setup VLAN tagging for port %d: %pe\n",
 				port, ERR_PTR(err));
-			return err;
+			goto unwind;
 		}
 	}
 
 	return 0;
+
+unwind:
+	/* Tear down only the ports that were set up before the failure. */
+	while (port-- > 0)
+		dsa_tag_8021q_port_teardown(ds, port);
+	return err;
 }
 
 static void dsa_tag_8021q_teardown(struct dsa_switch *ds)
@@ -417,6 +433,7 @@ static void dsa_tag_8021q_teardown(struc
 
 int dsa_tag_8021q_register(struct dsa_switch *ds, __be16 proto)
 {
+	struct dsa_tag_8021q_vlan *v, *n;
 	struct dsa_8021q_context *ctx;
 	int err;
 
@@ -438,6 +455,14 @@ int dsa_tag_8021q_register(struct dsa_sw
 	return 0;
 
 err_free:
+	/* The setup unwind leaves nothing installed, but a failed delete can
+	 * leave a reference behind. Free it with the context.
+	 */
+	list_for_each_entry_safe(v, n, &ctx->vlans, list) {
+		list_del(&v->list);
+		kfree(v);
+	}
+	ds->tag_8021q_ctx = NULL;
 	kfree(ctx);
 	return err;
 }
