+/* Caller holds RTNL; deleting a VIF need not delete its net_device. */
+static void ip6mr_sync_vif_delete(struct mr_table *mrt, int vifi)
+{
+	struct mr_mfc *entry;
+
+	if (!net_eq(read_pnet(&mrt->net), &init_net) ||
+	    mrt->id != RT6_TABLE_DFLT)
+		return;
+	list_for_each_entry(entry, &mrt->mfc_cache_list, list) {
+		struct mfc6_cache *cache = (struct mfc6_cache *)entry;
+
+		if (entry->mfc_parent == vifi ||
+		    (entry->mfc_un.res.ttls[vifi] > 0 &&
+		     entry->mfc_un.res.ttls[vifi] < 255))
+			ip6mr_sync_entry_delete(&cache->mf6c_origin,
+					       &cache->mf6c_mcastgrp);
+	}
+}
