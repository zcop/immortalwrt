+/* Rebuild from the bridge's current MDB, not the possibly stale event delta.
+ * A bridge with a software, Wi-Fi or second-conduit port stays in software.
+ */
+void qca8k_qinq_ipv4_mc_sync(struct dsa_switch *ds, struct dsa_db db,
+			    __be32 group)
+{
+	struct qca8k_priv *priv = ds->priv;
+	struct net_device *br, *lower;
+	struct list_head *iter;
+	u32 ifindices[QCA8K_NUM_PORTS];
+	int count, i, cpu = -1;
+	u8 ports = 0;
+	u16 cvid;
+
+	if (!priv->qinq || !qca8k_qinq_multicast || !group ||
+	    db.type != DSA_DB_BRIDGE || !db.bridge.num)
+		return;
+	br = db.bridge.dev;
+	cvid = dsa_tag_8021q_bridge_vid(db.bridge.num);
+	ASSERT_RTNL();
+	count = br_qinq_ipv4_mc_members(br, group, ifindices, ARRAY_SIZE(ifindices));
+	if (count <= 0)
+		goto withdraw;
+
+	netdev_for_each_lower_dev(br, lower, iter) {
+		struct dsa_port *dp;
+
+		if (!dsa_user_dev_check(lower))
+			goto withdraw;
+		dp = dsa_port_from_netdev(lower);
+		if (IS_ERR(dp) || dp->ds != ds || !dp->cpu_dp ||
+		    dsa_port_bridge_dev_get(dp) != br)
+			goto withdraw;
+		if (cpu >= 0 && cpu != dp->cpu_dp->index)
+			goto withdraw;
+		cpu = dp->cpu_dp->index;
+		for (i = 0; i < count; i++)
+			if (ifindices[i] == lower->ifindex)
+				ports |= BIT(dp->index);
+	}
+	if (hweight8(ports) != count || qca8k_qinq_ipv4_mc_set(ds, cpu, cvid, group, ports))
+		goto withdraw;
+	return;
+
+withdraw:
+	qca8k_qinq_ipv4_mc_set(ds, 0, cvid, group, 0);
+	qca8k_qinq_ipv4_mc_set(ds, 5, cvid, group, 0);
 }
 
