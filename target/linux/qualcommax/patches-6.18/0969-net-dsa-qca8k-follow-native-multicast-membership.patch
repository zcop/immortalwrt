+/* Return the complete native bridge output set for unfiltered IGMPv2.
+ * The switch cannot emulate source lists, router ports or MAC conversion.
+ */
+int br_qinq_ipv4_mc_members(struct net_device *dev, __be32 group, u32 *ports,
+			    unsigned int limit)
+{
+	struct br_ip key = { .dst.ip4 = group, .proto = htons(ETH_P_IP) };
+	struct net_bridge_mdb_entry *entry;
+	struct net_bridge_port_group *pg;
+	struct net_bridge_mcast *ctx;
+	struct net_bridge *br;
+	unsigned int count = 0;
+	int ret = -EOPNOTSUPP;
+
+	if (!netif_is_bridge_master(dev) || !netif_running(dev) ||
+	    !ipv4_is_multicast(group) || ipv4_is_local_multicast(group))
+		return ret;
+
+	br = netdev_priv(dev);
+	ctx = &br->multicast_ctx;
+	spin_lock_bh(&br->multicast_lock);
+	if (br_vlan_enabled(dev) || !br_opt_get(br, BROPT_MULTICAST_ENABLED) ||
+	    ctx->multicast_igmp_version != 2 || !ctx->multicast_querier ||
+	    !hlist_empty(&ctx->ip4_mc_router_list) ||
+	    !__br_multicast_querier_exists(ctx, &ctx->ip4_other_query, false))
+		goto out;
+
+	entry = br_mdb_ip_get(br, &key);
+	if (!entry) {
+		ret = 0;
+		goto out;
+	}
+	if (entry->host_joined)
+		goto out;
+	for (pg = mlock_dereference(entry->ports, br); pg;
+	     pg = mlock_dereference(pg->next, br)) {
+		struct net_bridge_port *p = pg->key.port;
+
+		if (pg->filter_mode != MCAST_EXCLUDE || !hlist_empty(&pg->src_list) ||
+		    (pg->flags & MDB_PG_FLAGS_BLOCKED) ||
+		    (p->flags & (BR_MULTICAST_TO_UNICAST | BR_ISOLATED | BR_PORT_LOCKED)))
+			goto out;
+		if (p->state != BR_STATE_FORWARDING)
+			continue;
+		if (count == limit) {
+			ret = -ENOSPC;
+			goto out;
+		}
+		ports[count++] = p->dev->ifindex;
+	}
+	ret = count;
+out:
+	spin_unlock_bh(&br->multicast_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(br_qinq_ipv4_mc_members);
+
