+/* Group Ethernet aliases differ in the upper five IPv4 multicast bits.
+ * Keep them in the private outer tag. The stream's VLAN stays in C-VID.
+ */
+static inline u16 dsa_qca_qinq_ipv4_mc_svid(__be32 group)
+{
+	return 4000 + ((((ntohl(group) >> 23) & 0x1f) + 2) & 0x1f);
+}
