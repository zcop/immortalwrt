+/* CPU QinQ IPv4 multicast steering. The caller owns the receiver policy. */
+static int qca8k_qinq_mc_write(struct qca8k_priv *priv,
+			       const struct qca8k_qinq_mc *mc, u8 ports)
+{
+	u32 action[3] = {}, value[5] = {}, mask[5] = {};
+	u32 group = ntohl(mc->group);
+	u16 svid = dsa_qca_qinq_ipv4_mc_svid(mc->group);
+
+	if (!ports)
+		return qca8k_qinq_rule(priv, mc->slot, value, mask, action);
+
+	/* The multicast MAC carries the low 23 group bits. The SVID carries
+	 * the other five, so aliased multicast MACs still get separate rules.
+	 */
+	value[0] = 0x5e000000 | (group & 0x7fffff);
+	value[1] = 0x0100;
+	value[2] = (svid << 8) | ((u32)(mc->cvid & 0xff) << 24);
+	value[3] = 0xc3000000 | (mc->cvid >> 8);
+	value[4] = BIT(mc->cpu);
+	mask[0] = U32_MAX;
+	mask[1] = 0xffff;
+	mask[2] = 0xff0fff00;
+	mask[3] = 0xf;
+	mask[4] = 0xff;
+	action[1] = (ports & 7) << 29;
+	action[2] = BIT(4) | (ports >> 3);
+
+	return qca8k_qinq_rule(priv, mc->slot, value, mask, action);
+}
+
+static int qca8k_qinq_mc_remove(struct qca8k_priv *priv,
+				struct qca8k_qinq_mc *mc)
+{
+	int ret, port;
+
+	ret = qca8k_qinq_mc_write(priv, mc, 0);
+	if (!ret) {
+		memset(mc, 0, sizeof(*mc));
+		return 0;
+	}
+
+	/* Keep ownership of the slot if the hardware state is unknown. */
+	for (port = 1; port <= 4; port++)
+		if (mc->ports & BIT(port))
+			qca8k_qinq_fault(priv, port);
+	return ret;
+}
+
+static int qca8k_qinq_mc_prune_port(struct qca8k_priv *priv, int port)
+{
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(priv->qinq_mc); i++) {
+		struct qca8k_qinq_mc *mc = &priv->qinq_mc[i];
+
+		if (!mc->group || !(mc->ports & BIT(port)))
+			continue;
+		ret = qca8k_qinq_mc_remove(priv, mc);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+int qca8k_qinq_ipv4_mc_set(struct dsa_switch *ds, int cpu, u16 cvid,
+			   __be32 group, u8 ports)
+{
+	struct qca8k_priv *priv = ds->priv;
+	struct qca8k_qinq_mc *entry = NULL, *free = NULL;
+	struct net_device *bridge = NULL;
+	int i, slot, ret;
+
+	ASSERT_RTNL();
+	if (!priv->qinq || !priv->qinq_acl_owned ||
+	    (cpu != 0 && cpu != 5) || (ports & ~GENMASK(4, 1)) ||
+	    !ipv4_is_multicast(group) || ipv4_is_local_multicast(group))
+		return -EOPNOTSUPP;
+
+	for (i = 0; i < ARRAY_SIZE(priv->qinq_mc); i++) {
+		struct qca8k_qinq_mc *mc = &priv->qinq_mc[i];
+
+		if (mc->group == group && mc->cvid == cvid && mc->cpu == cpu) {
+			entry = mc;
+			break;
+		}
+		if (!mc->group && !free)
+			free = mc;
+	}
+
+	if (!ports)
+		return entry ? qca8k_qinq_mc_remove(priv, entry) : 0;
+
+	/* Destination overrides bypass VTU egress checks. Recheck that the
+	 * requested ports belong to one native bridge and the owning CPU.
+	 */
+	for (i = 1; i <= 4; i++) {
+		struct dsa_port *dp;
+		struct net_device *master;
+
+		if (!(ports & BIT(i)))
+			continue;
+		dp = dsa_to_port(ds, i);
+		master = dsa_port_bridge_dev_get(dp);
+		if (!master || !dp->cpu_dp || dp->cpu_dp->index != cpu ||
+		    dsa_port_bridge_num_get(dp) < 1 ||
+		    cvid != dsa_tag_8021q_bridge_vid(dsa_port_bridge_num_get(dp)) ||
+		    priv->qinq_native_vid[i] != cvid || br_vlan_enabled(master) ||
+		    (priv->qinq_fault_map & BIT(i)) || dp->stp_state != BR_STATE_FORWARDING ||
+		    (bridge && bridge != master))
+			return -EOPNOTSUPP;
+		bridge = master;
+	}
+
+	if (entry && entry->ports == ports)
+		return 0;
+	if (!entry) {
+		if (!free)
+			return -ENOSPC;
+		slot = qca8k_qinq_customer_slot(priv);
+		if (slot < 0)
+			return slot;
+		entry = free;
+		*entry = (struct qca8k_qinq_mc) {
+			.group = group, .cvid = cvid, .cpu = cpu, .slot = slot,
+		};
+	}
+
+	ret = qca8k_qinq_mc_write(priv, entry, ports);
+	if (ret) {
+		entry->ports |= ports;
+		qca8k_qinq_mc_remove(priv, entry);
+		return ret;
+	}
+	entry->ports = ports;
+	return 0;
 }
 
