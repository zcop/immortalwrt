+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_DSA_QINQ_MCAST_H
+#define _LINUX_DSA_QINQ_MCAST_H
+
+#include <net/dsa.h>
+
+/* Both helpers are called under RCU. The backend validates the bridge and
+ * the exact receiver set when resolving a wire path.
+ */
+static inline struct dsa_switch *dsa_qinq_ipv4_mc_switch(struct net_device *dev)
+{
+#if IS_ENABLED(CONFIG_NET_DSA)
+	struct dsa_port *dp;
+
+	if (!dsa_user_dev_check(dev))
+		return NULL;
+	dp = dsa_port_from_netdev(dev);
+	if (!IS_ERR_OR_NULL(dp) && smp_load_acquire(&dp->ds->qinq_ipv4_mc_enabled) &&
+	    dp->ds->ops->qinq_ipv4_mc_path)
+		return dp->ds;
+#endif
+	return NULL;
+}
+
+static inline struct dsa_switch *dsa_qinq_ipv4_mc_bridge(struct net_device *br)
+{
+	struct net_device *lower;
+	struct dsa_switch *ds = NULL;
+	struct list_head *iter;
+
+	if (!netif_is_bridge_master(br))
+		return NULL;
+	iter = &br->adj_list.lower;
+	while ((lower = netdev_next_lower_dev_rcu(br, &iter))) {
+		struct dsa_switch *lower_ds = dsa_qinq_ipv4_mc_switch(lower);
+
+		if (!lower_ds || (ds && lower_ds != ds))
+			return NULL;
+		ds = lower_ds;
+	}
+	return ds;
+}
+
+#endif /* _LINUX_DSA_QINQ_MCAST_H */
