+	*target = (struct qca8k_qinq_mc_target){};
+	if (!count || count > QCA8K_NUM_PORTS)
+		return false;
+	while ((lower = netdev_next_lower_dev_rcu(br, &iter))) {
+		struct dsa_port *dp, *cpu;
+		u16 cvid;
+
+		if (!dsa_user_dev_check(lower) ||
+		    netdev_master_upper_dev_get_rcu(lower) != br)
+			return false;
+		dp = dsa_port_from_netdev(lower);
+		if (IS_ERR_OR_NULL(dp) || dp->ds != ds)
+			return false;
+		cpu = READ_ONCE(dp->cpu_dp);
+		cvid = READ_ONCE(priv->qinq_native_vid[dp->index]);
+		if (!cpu || !cvid || (target->cpu &&
+		    (target->cpu != cpu || target->cvid != cvid)))
+			return false;
+		target->cpu = cpu;
+		target->cvid = cvid;
+		for (i = 0; i < count; i++)
+			if (ifindices[i] == lower->ifindex)
+				target->ports |= BIT(dp->index);
+	}
+	return hweight8(target->ports) == count;
+}
