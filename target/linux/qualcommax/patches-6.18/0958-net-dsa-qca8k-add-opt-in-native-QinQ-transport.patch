+int qca8k_qinq_vlan_add(struct dsa_switch *ds, int port, u16 vid, u16 flags)
+{
+	struct qca8k_priv *priv = ds->priv;
+	bool pvid = flags & BRIDGE_VLAN_INFO_PVID;
+	int ret;
+
+	if (!priv->qinq)
+		return -EOPNOTSUPP;
+	ret = qca8k_vlan_add(priv, port, vid, flags & BRIDGE_VLAN_INFO_UNTAGGED);
+	if (ret)
+		goto fail;
+	if (pvid && dsa_is_user_port(ds, port)) {
+		ret = qca8k_rmw(priv, QCA8K_REG_PORT_VLAN_CTRL0(port),
+				QCA8K_PORT_VLAN_CVID_MASK, QCA8K_PORT_VLAN_CVID(vid));
+		if (ret)
+			goto fail;
+		priv->qinq_native_vid[port] = vid;
+	}
+	return 0;
+fail:
+	qca8k_qinq_fault(priv, port);
+	return ret;
