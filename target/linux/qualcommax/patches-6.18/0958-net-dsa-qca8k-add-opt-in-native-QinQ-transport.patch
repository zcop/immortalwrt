--- /dev/null
+++ b/drivers/net/dsa/qca/qca8k-qinq.c
@@ -0,0 +1,297 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Boot-only QCA8337 native/unaware QinQ bring-up. No translation SRAM. */
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/dsa/8021q.h>
+#include <linux/if_bridge.h>
+#include <linux/if_vlan.h>
+#include <linux/rtnetlink.h>
+#include "qca8k.h"
+
+#define QINQ_ACL_FIRST 89
+#define QINQ_ACL_LAST 95
+#define QINQ_ACL_V(n, w) (0x58000 + (n) * 32 + (w) * 4)
+#define QINQ_ACL_M(n, w) (0x59000 + (n) * 32 + (w) * 4)
+#define QINQ_ACL_A(n, w) (0x5a000 + (n) * 16 + (w) * 4)
+#define QINQ_RULE_COMPLETE GENMASK(7, 6)
+#define QINQ_RULE_MAC 1
+#define QINQ_RULE_EHMAC 7
+#define QINQ_DENY (7 << 6)
+#define QINQ_MODULE 0x30
+#define QINQ_MODULE_ACL BIT(1)
+#define QINQ_SERVICE_TAG 0x48
+#define QINQ_SECOND_FILTER 0x418
+#define QINQ_SECOND_FILTER_BYPASS BIT(1)
+#define QINQ_FORCE_PORT_VLAN BIT(10)
+
+/* The MDIO direct SRAM path corrupted mask words when writing actions on
+ * the measured QCA8337. Use the documented complete-entry function window.
+ * All window transactions, including readback, hold reg_mutex.
+ */
+#define QINQ_ACL_FUNC 0x400
+#define QINQ_ACL_DATA(w) (0x404 + (w) * 4)
+#define QINQ_ACL_BUSY BIT(31)
+#define QINQ_ACL_READ BIT(10)
+#define QINQ_ACL_VALUES 0
+#define QINQ_ACL_MASKS 1
+#define QINQ_ACL_ACTIONS 2
+
+static int qca8k_qinq_acl_wait(struct qca8k_priv *priv)
+{
+	u32 value;
+	int i, ret;
+
+	for (i = 0; i < 100; i++) {
+		ret = qca8k_read(priv, QINQ_ACL_FUNC, &value);
+		if (ret)
+			return ret;
+		if (!(value & QINQ_ACL_BUSY))
+			return 0;
+		usleep_range(100, 200);
+	}
+	return -ETIMEDOUT;
+}
+
+static int qca8k_qinq_acl_read(struct qca8k_priv *priv, int slot, int type,
+			      u32 *data, int words)
+{
+	int i, ret;
+
+	lockdep_assert_held(&priv->reg_mutex);
+	ret = qca8k_qinq_acl_wait(priv);
+	if (ret)
+		return ret;
+	ret = qca8k_write(priv, QINQ_ACL_FUNC,
+			 QINQ_ACL_BUSY | QINQ_ACL_READ | (type << 8) | slot);
+	if (ret)
+		return ret;
+	ret = qca8k_qinq_acl_wait(priv);
+	if (ret)
+		return ret;
+	for (i = 0; i < words; i++) {
+		ret = qca8k_read(priv, QINQ_ACL_DATA(i), &data[i]);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int qca8k_qinq_acl_write(struct qca8k_priv *priv, int slot, int type,
+			       const u32 *data, int words)
+{
+	int i, ret;
+
+	lockdep_assert_held(&priv->reg_mutex);
+	ret = qca8k_qinq_acl_wait(priv);
+	if (ret)
+		return ret;
+	for (i = 0; i < words; i++) {
+		ret = qca8k_write(priv, QINQ_ACL_DATA(i), data[i]);
+		if (ret)
+			return ret;
+	}
+	ret = qca8k_write(priv, QINQ_ACL_FUNC,
+			 QINQ_ACL_BUSY | (type << 8) | slot);
+	if (ret)
+		return ret;
+	return qca8k_qinq_acl_wait(priv);
+}
+
+static int qca8k_qinq_rule(struct qca8k_priv *priv, int slot,
+			   const u32 value[5], const u32 mask[5],
+			   const u32 action[3])
+{
+	u32 disabled[5] = {}, check[5];
+	int ret;
+
+	mutex_lock(&priv->reg_mutex);
+	/* Publish validity last, then verify the complete committed entry. */
+	ret = qca8k_qinq_acl_write(priv, slot, QINQ_ACL_MASKS, disabled, 5);
+	if (ret)
+		goto out;
+	ret = qca8k_qinq_acl_write(priv, slot, QINQ_ACL_VALUES, value, 5);
+	if (ret)
+		goto out;
+	ret = qca8k_qinq_acl_write(priv, slot, QINQ_ACL_ACTIONS, action, 3);
+	if (ret)
+		goto out;
+	ret = qca8k_qinq_acl_write(priv, slot, QINQ_ACL_MASKS, mask, 5);
+	if (ret)
+		goto out;
+	ret = qca8k_qinq_acl_read(priv, slot, QINQ_ACL_VALUES, check, 5);
+	if (!ret && memcmp(value, check, sizeof(check)))
+		ret = -EIO;
+	if (ret)
+		goto out;
+	ret = qca8k_qinq_acl_read(priv, slot, QINQ_ACL_ACTIONS, check, 3);
+	if (!ret && memcmp(action, check, 3 * sizeof(u32)))
+		ret = -EIO;
+	if (ret)
+		goto out;
+	ret = qca8k_qinq_acl_read(priv, slot, QINQ_ACL_MASKS, check, 5);
+	if (!ret && memcmp(mask, check, sizeof(check)))
+		ret = -EIO;
+out:
+	if (ret)
+		qca8k_qinq_acl_write(priv, slot, QINQ_ACL_MASKS, disabled, 5);
+	mutex_unlock(&priv->reg_mutex);
+	return ret;
+}
+
+void qca8k_qinq_fault(struct qca8k_priv *priv, int port)
+{
+	priv->qinq_fault_map |= BIT(port);
+	qca8k_port_set_status(priv, port, 0);
+	dev_err(priv->dev, "QinQ configuration failed; port %d held down\n", port);
+}
+
+int qca8k_qinq_conduit(struct qca8k_priv *priv, int port, int cpu)
+{
+	struct dsa_port *dp = dsa_to_port(priv->ds, port);
+	u16 svid = dsa_tag_8021q_standalone_vid(dp);
+	u32 value[5] = { 0, 0, svid << 8, 0xc1000000, BIT(cpu) };
+	u32 mask[5] = { 0, 0, 0xfff00, 0, 0xcf };
+	u32 action[3] = { 0, (BIT(port) & 7) << 29, BIT(4) | (BIT(port) >> 3) };
+	int ret;
+
+	if (port < 1 || port > 4 || (cpu != 0 && cpu != 5))
+		return -EOPNOTSUPP;
+	ret = qca8k_qinq_rule(priv, 89 + port, value, mask, action);
+	if (ret)
+		qca8k_qinq_fault(priv, port);
+	return ret;
+}
+
+void qca8k_qinq_teardown(struct dsa_switch *ds)
+{
+	struct qca8k_priv *priv = ds->priv;
+	struct dsa_port *dp;
+	u32 disabled[5] = {};
+	int slot;
+
+	if (!priv->qinq || !priv->qinq_acl_owned)
+		return;
+	dsa_switch_for_each_user_port(dp, ds)
+		qca8k_port_set_status(priv, dp->index, 0);
+	if (ds->tag_8021q_ctx) {
+		rtnl_lock();
+		dsa_tag_8021q_unregister(ds);
+		rtnl_unlock();
+	}
+	mutex_lock(&priv->reg_mutex);
+	for (slot = QINQ_ACL_FIRST; slot <= QINQ_ACL_LAST; slot++)
+		qca8k_qinq_acl_write(priv, slot, QINQ_ACL_MASKS, disabled, 5);
+	mutex_unlock(&priv->reg_mutex);
+	priv->qinq_acl_owned = false;
+}
+
+int qca8k_qinq_setup(struct dsa_switch *ds)
+{
+	struct qca8k_priv *priv = ds->priv;
+	struct dsa_port *dp;
+	u32 value[5] = {}, mask[5] = {}, action[3] = {};
+	u32 users = 0, entry[5], flood;
+	int ret, slot;
+
+	/* Initial hardware scope is the measured AX3000 wiring only. */
+	dsa_switch_for_each_user_port(dp, ds)
+		users |= BIT(dp->index);
+	if (priv->switch_id != QCA8K_ID_QCA8337 ||
+	    dsa_cpu_ports(ds) != (BIT(0) | BIT(5)) || users != GENMASK(4, 1))
+		return -EOPNOTSUPP;
+
+	for (slot = QINQ_ACL_FIRST; slot <= QINQ_ACL_LAST; slot++) {
+		mutex_lock(&priv->reg_mutex);
+		ret = qca8k_qinq_acl_read(priv, slot, QINQ_ACL_MASKS, entry, 5);
+		mutex_unlock(&priv->reg_mutex);
+		if (ret)
+			return ret;
+		if (entry[4] & 7)
+			return -EBUSY;
+	}
+	priv->qinq_acl_owned = true;
+	/* A headerless CPU packet has no QCA destination bitmap. VLAN and
+	 * port membership still constrain these flood destinations.
+	 */
+	flood = users | dsa_cpu_ports(ds);
+	ret = qca8k_write(priv, QCA8K_REG_GLOBAL_FW_CTRL1,
+			 flood | (flood << 8) | (flood << 16) | (flood << 24));
+	if (ret)
+		goto fail;
+	ret = qca8k_rmw(priv, QINQ_SERVICE_TAG, BIT(17) | GENMASK(15, 0), ETH_P_8021AD);
+	if (ret)
+		goto fail;
+	ret = qca8k_rmw(priv, QINQ_SECOND_FILTER, QINQ_SECOND_FILTER_BYPASS,
+			QINQ_SECOND_FILTER_BYPASS);
+	if (ret)
+		goto fail;
+
+	dsa_switch_for_each_cpu_port(dp, ds) {
+		ret = qca8k_write(priv, QCA8K_REG_PORT_VLAN_CTRL1(dp->index), 0x2200);
+		if (ret)
+			goto fail;
+		ret = qca8k_rmw(priv, QCA8K_PORT_LOOKUP_CTRL(dp->index),
+				QCA8K_PORT_LOOKUP_VLAN_MODE_MASK | QINQ_FORCE_PORT_VLAN,
+				QCA8K_PORT_LOOKUP_VLAN_MODE_FALLBACK | QINQ_FORCE_PORT_VLAN);
+		if (ret)
+			goto fail;
+	}
+	dsa_switch_for_each_user_port(dp, ds) {
+		u16 svid = dsa_tag_8021q_standalone_vid(dp);
+
+		ret = qca8k_write(priv, QCA8K_REG_PORT_VLAN_CTRL0(dp->index),
+				  QCA8K_PORT_VLAN_SVID(svid) | QCA8K_PORT_VLAN_CVID(svid));
+		if (ret)
+			goto fail;
+		ret = qca8k_write(priv, QCA8K_REG_PORT_VLAN_CTRL1(dp->index), 0x3080);
+		if (ret)
+			goto fail;
+		ret = qca8k_rmw(priv, QCA8K_PORT_LOOKUP_CTRL(dp->index),
+				QCA8K_PORT_LOOKUP_VLAN_MODE_MASK | QINQ_FORCE_PORT_VLAN,
+				QCA8K_PORT_LOOKUP_VLAN_MODE_FALLBACK | QINQ_FORCE_PORT_VLAN);
+		if (ret)
+			goto fail;
+		ret = qca8k_qinq_conduit(priv, dp->index, dp->cpu_dp->index);
+		if (ret)
+			goto fail;
+	}
+
+	/* Reject external S-tags before a user can impersonate another SVID.
+	 * Format bits refer to received tags, not the default inserted SVID.
+	 * This negative admission rule still needs live spoofing acceptance.
+	 */
+	value[3] = BIT(31) | BIT(30) | BIT(24);
+	value[4] = users;
+	mask[4] = QINQ_RULE_COMPLETE | BIT(3) | QINQ_RULE_EHMAC;
+	action[2] = QINQ_DENY;
+	ret = qca8k_qinq_rule(priv, 89, value, mask, action);
+	if (ret)
+		goto fail;
+
+	/* Empty destination is the CPU default. Exact steering has the first
+	 * enabled destination override. Do not use DP_ACT=DROP here: the ASIC
+	 * ORs that field across matches and would also drop valid steering.
+	 * Unknown-SVID packet rejection still needs live acceptance.
+	 */
+	memset(value, 0, sizeof(value));
+	value[4] = dsa_cpu_ports(ds);
+	action[2] = BIT(4); /* Destination override enabled, no egress ports. */
+	mask[4] = QINQ_RULE_COMPLETE | BIT(3) | QINQ_RULE_MAC;
+	ret = qca8k_qinq_rule(priv, 95, value, mask, action);
+	if (ret)
+		goto fail;
+	ret = qca8k_rmw(priv, QINQ_MODULE, QINQ_MODULE_ACL, QINQ_MODULE_ACL);
+	if (ret)
+		goto fail;
+	ds->max_num_bridges = DSA_TAG_8021Q_MAX_NUM_BRIDGES;
+	rtnl_lock();
+	ret = dsa_tag_8021q_register(ds, htons(ETH_P_8021AD));
+	rtnl_unlock();
+	if (ret)
+		goto fail;
+	dev_warn(priv->dev, "experimental QinQ: native/unaware data only; MDIO management\n");
+	return 0;
+fail:
+	qca8k_qinq_teardown(ds);
+	return ret;
+}
