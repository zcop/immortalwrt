+
+int qca8k_qinq_vlan_del(struct dsa_switch *ds, int port, u16 vid)
+{
+	struct qca8k_priv *priv = ds->priv;
+	int ret;
+
+	if (!priv->qinq)
+		return -EOPNOTSUPP;
+	ret = qca8k_vlan_del(priv, port, vid);
+	if (ret) {
