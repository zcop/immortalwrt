/dts-v1/;

#include "ipq5018.dtsi"

/ {
	model = "Xiaomi CR881x (minimal Linux 6.18 boot test)";
	compatible = "xiaomi,cr881x", "qcom,ipq5018";

	aliases {
		serial0 = &blsp1_uart1;
	};

	chosen {
		/* Override Xiaomi U-Boot's root=mtd:ubi_rootfs argument. */
		bootargs-append = " root=/dev/ubiblock0_1 ignore_loglevel loglevel=8";
		stdout-path = "serial0:115200n8";
	};
};

/* CR881x has 256 MiB and its bootloader does not fix up this node. */
&{/memory@40000000} {
	reg = <0x0 0x40000000 0x0 0x10000000>;
};

/* Match the clock and console setup used by working IPQ5018 boards. */
&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&tlmm {
	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	serial_0_pins: uart0-state {
		pins = "gpio20", "gpio21";
		function = "blsp0_uart0";
		drive-strength = <8>;
		bias-disable;
	};
};

&blsp1_uart1 {
	status = "okay";

	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;

		nand-ecc-engine = <&qpic_nand>;
		nand-bus-width = <8>;

		partitions {
			compatible = "qcom,smem-part";
		};
	};
};
