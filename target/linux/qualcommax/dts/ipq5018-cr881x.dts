/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "Xiaomi CR881x";
	compatible = "xiaomi,cr881x", "qcom,ipq5018";

	aliases {
		serial0 = &blsp1_uart1;
		label-mac-device = &gmac0;
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
		led-boot = &led_system_blue;
		led-failsafe = &led_system_red;
		led-running = &led_system_blue;
		led-upgrade = &led_system_red;
	};

	chosen {
		/* Override Xiaomi U-Boot's root=mtd:ubi_rootfs argument. */
		bootargs-append = " root=/dev/ubiblock0_1 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";

		led_system_blue: led-system-blue {
			label = "blue:system";
			gpios = <&tlmm 24 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led_system_red: led-system-red {
			label = "red:system";
			gpios = <&tlmm 25 GPIO_ACTIVE_HIGH>;
		};

		led-internet-blue {
			label = "blue:internet";
			gpios = <&tlmm 26 GPIO_ACTIVE_HIGH>;
		};

		led-internet-red {
			label = "red:internet";
			gpios = <&tlmm 27 GPIO_ACTIVE_HIGH>;
		};
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset {
			label = "reset";
			gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_KEY>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};

		mesh {
			label = "mesh";
			gpios = <&tlmm 28 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_KEY>;
			linux,code = <KEY_WPS_BUTTON>;
			debounce-interval = <60>;
		};
	};
};

/* CR881x has 256 MiB and its bootloader does not fix up this node. */
&{/memory@40000000} {
	reg = <0x0 0x40000000 0x0 0x10000000>;
};

/* Match the clock and console setup used by working IPQ5018 boards. */
&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&tlmm {
	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	switch_reset_pins: switch-reset-state {
		pins = "gpio39";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	leds_pins: leds-state {
		pins = "gpio24", "gpio25", "gpio26", "gpio27";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	button_pins: buttons-state {
		pins = "gpio28", "gpio38";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	serial_0_pins: uart0-state {
		pins = "gpio20", "gpio21";
		function = "blsp0_uart0";
		drive-strength = <8>;
		bias-disable;
	};
};

&blsp1_uart1 {
	status = "okay";

	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
};

&qpic_bam {
	status = "okay";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&tsens {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;

		nand-ecc-engine = <&qpic_nand>;
		nand-bus-width = <8>;

		partitions {
			compatible = "qcom,smem-part";

			partition-0-art {
				label = "0:art";
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					mac_addr_dp1: macaddr@0 {
						compatible = "mac-base";
						#nvmem-cell-cells = <1>;
						reg = <0x0 0x6>;
					};

					mac_addr_dp2: macaddr@6 {
						compatible = "mac-base";
						#nvmem-cell-cells = <1>;
						reg = <0x6 0x6>;
					};
				};
			};
		};
	};
};

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_50MHZ>;
};

&gmac0 {
	status = "okay";

	nvmem-cells = <&mac_addr_dp1 0>;
	nvmem-cell-names = "mac-address";
};

&gmac1 {
	status = "okay";
	phy-mode = "sgmii";

	nvmem-cells = <&mac_addr_dp2 0>;
	nvmem-cell-names = "mac-address";

	fixed-link {
		speed = <1000>;
		full-duplex;
		pause;
		asym-pause;
	};
};

&mdio0 {
	status = "okay";
};

&ge_phy {
	qcom,dac-preset-short-cable;
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>, <&switch_reset_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;
	reset-assert-us = <10000>;
	reset-deassert-us = <50000>;

	ethernet-switch@1d {
		compatible = "motorcomm,yt9215";
		reg = <0x1d>;

		motorcomm,rma-slow-action = <2>;
		motorcomm,ctrlpkt-lldp-act = <0x400>;
		motorcomm,ctrlpkt-lldp-eee-act = <0x400>;
		motorcomm,temp-sensor-supported;
		motorcomm,secondary-conduit-user-mask = <0x8>;

		mdio {
			#address-cells = <1>;
			#size-cells = <0>;

			sw_phy0: phy@0 { reg = <0>; };
			sw_phy1: phy@1 { reg = <1>; };
			sw_phy2: phy@2 { reg = <2>; };
			sw_phy3: phy@3 { reg = <3>; };
			sw_phy4: phy@4 { reg = <4>; };
		};

		mdio-external {
			#address-cells = <1>;
			#size-cells = <0>;
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				label = "lan1";
				phy-mode = "internal";
				phy-handle = <&sw_phy0>;
			};

			port@1 {
				reg = <1>;
				label = "lan2";
				phy-mode = "internal";
				phy-handle = <&sw_phy1>;
			};

			port@2 {
				reg = <2>;
				label = "lan3";
				phy-mode = "internal";
				phy-handle = <&sw_phy2>;
			};

			port@3 {
				reg = <3>;
				label = "wan";
				phy-mode = "internal";
				phy-handle = <&sw_phy3>;
			};

			port@4 {
				reg = <4>;
				label = "cpu";
				phy-mode = "internal";
				motorcomm,conduit-role = "secondary-conduit";
				ethernet = <&gmac0>;

				fixed-link {
					speed = <1000>;
					full-duplex;
					pause;
					asym-pause;
				};
			};

			port@8 {
				reg = <8>;
				phy-mode = "sgmii";
				motorcomm,serdes-revsgmii;
				motorcomm,conduit-role = "primary-conduit";
				ethernet = <&gmac1>;

				fixed-link {
					speed = <1000>;
					full-duplex;
					pause;
					asym-pause;
				};
			};
		};
	};
};

&q6v5_wcss {
	status = "okay";

	qcom,bootargs_smem = <507>;
	boot-args = <0x2 4 2 18 0 0>;
};

&wifi {
	status = "okay";

	qcom,rproc = <&q6_wcss_pd1>;
	qcom,board_id = <0x23>;
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4c400000>;
};

&wifi1 {
	status = "okay";

	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,board_id = <0x60>;
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4d100000>;
	qcom,m3-dump-addr = <0x4df00000>;
};
