Subject: [PATCH] net: dsa: qca-qinq: retain registered standalone customer tags

Preserve one customer C-tag on a live standalone 802.1Q upper. Validate the
exact registered upper, protocol and private-VID exclusions before admitting
the packet. Native bridge/port transport and the YT921x taggers are unchanged.
Switch-side VTU/ACL admission is provided by the platform driver patch.

--- /dev/null
+++ b/include/linux/dsa/qca_qinq.h
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_DSA_QCA_QINQ_H
+#define _LINUX_DSA_QCA_QINQ_H
+
+#include <linux/if_ether.h>
+#include <linux/if_vlan.h>
+#include <linux/netdevice.h>
+#include <linux/dsa/8021q.h>
+#include <net/dsa.h>
+
+static inline bool dsa_qca_qinq_customer_vid_valid(struct dsa_switch *ds,
+						   u16 vid)
+{
+	struct dsa_port *dp;
+	unsigned int num;
+
+	if (!ds || !vid || vid >= VLAN_VID_MASK)
+		return false;
+
+	dsa_switch_for_each_user_port(dp, ds) {
+		if (vid == dsa_tag_8021q_standalone_vid(dp))
+			return false;
+	}
+
+	for (num = 1; num <= ds->max_num_bridges; num++) {
+		if (vid == dsa_tag_8021q_bridge_vid(num))
+			return false;
+	}
+	return true;
+}
+
+/* Must be called under RCU read lock. */
+static inline bool dsa_qca_qinq_direct_vid_valid(const struct dsa_port *dp,
+						 u16 vid)
+{
+	struct net_device *user, *upper;
+
+	if (!dp || !dp->ds || !dp->ds->dst || !dp->ds->dst->tag_ops ||
+	    dp->ds->dst->tag_ops->proto != DSA_TAG_PROTO_QCA_QINQ)
+		return false;
+	if (!dsa_qca_qinq_customer_vid_valid(dp->ds, vid))
+		return false;
+	user = dp->user;
+	if (!user || !(user->features & NETIF_F_HW_VLAN_CTAG_FILTER))
+		return false;
+	if (dsa_port_bridge_dev_get(dp) ||
+	    netdev_master_upper_dev_get_rcu(user))
+		return false;
+	upper = __vlan_find_dev_deep_rcu(user, htons(ETH_P_8021Q), vid);
+	if (!upper || !is_vlan_dev(upper) || vlan_dev_real_dev(upper) != user ||
+	    vlan_dev_vlan_proto(upper) != htons(ETH_P_8021Q) ||
+	    vlan_dev_vlan_id(upper) != vid ||
+	    netdev_master_upper_dev_get_rcu(upper))
+		return false;
+	return true;
+}
+
+#endif /* _LINUX_DSA_QCA_QINQ_H */
