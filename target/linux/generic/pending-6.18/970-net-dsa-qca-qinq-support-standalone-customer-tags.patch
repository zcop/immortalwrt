+static bool qca_qinq_customer_tag(struct dsa_port *dp, struct sk_buff *skb,
+				  u16 *tci, bool *hwaccel)
+{
+	struct vlan_ethhdr *veh;
+	bool valid;
+
+	*hwaccel = false;
+	if (skb_vlan_tag_present(skb)) {
+		if (skb->vlan_proto != htons(ETH_P_8021Q) ||
+		    qca_qinq_is_vlan_tpid(eth_hdr(skb)->h_proto))
+			return false;
+		*tci = skb_vlan_tag_get(skb);
+		*hwaccel = true;
+	} else if (qca_qinq_is_vlan_tpid(eth_hdr(skb)->h_proto)) {
+		if (!pskb_may_pull(skb, ETH_HLEN + VLAN_HLEN))
+			return false;
+		veh = vlan_eth_hdr(skb);
+		if (veh->h_vlan_proto != htons(ETH_P_8021Q) ||
+		    qca_qinq_is_vlan_tpid(veh->h_vlan_encapsulated_proto))
+			return false;
+		*tci = ntohs(veh->h_vlan_TCI);
+	} else {
+		return false;
+	}
+	rcu_read_lock();
+	valid = dsa_qca_qinq_direct_vid_valid(dp, *tci & VLAN_VID_MASK);
+	rcu_read_unlock();
+	return valid;
+}
