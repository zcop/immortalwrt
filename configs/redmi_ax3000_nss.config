# AX3000 native NSS/QinQ with the 256 MiB Wi-Fi allocation profile.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_redmi_ax3000_nss=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS_SEPARATE=y
CONFIG_PACKAGE_kmod-dsa-qca8k=y
CONFIG_DSA_QCA8K_EXPERIMENTAL_QINQ=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-zcop=y
CONFIG_PACKAGE_luci-app-zcop-dashboard=y
CONFIG_PACKAGE_luci-app-cr881x-wan-mode=y
# CONFIG_PACKAGE_luci-theme-argon is not set
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-qinq=y
CONFIG_PACKAGE_nss-firmware=y
# CONFIG_DSA_YT921X_EXPERIMENTAL_QINQ is not set
# CONFIG_KERNEL_SLUB_DEBUG is not set
# CONFIG_KERNEL_SLUB_DEBUG_ON is not set
CONFIG_ATH11K_MEM_PROFILE_256M=y
CONFIG_ATH11K_NSS_MEM_PROFILE_256M=y
# CONFIG_ATH11K_MEM_PROFILE_512M is not set
CONFIG_ATH11K_SMALLBUFFERS=y

# Run tools/nss/apply-qosmio-overlay.py before defconfig.
CONFIG_PACKAGE_kmod-qca-ssdk=y
CONFIG_NSS_FIRMWARE_VERSION_12_2=y
CONFIG_NSS_MEM_PROFILE_LOW=y
CONFIG_NSS_DRV_IPV6_ENABLE=y
CONFIG_NSS_DRV_VIRT_IF_ENABLE=y
CONFIG_NSS_DRV_VLAN_ENABLE=y
CONFIG_NSS_DRV_PPPOE_ENABLE=y
CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=y
CONFIG_NSS_DRV_WIFI_EXT_VDEV_ENABLE=y
CONFIG_ATH11K_NSS_SUPPORT=y
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y
